@startuml
!theme plain
left to right direction
skinparam shadowing false
skinparam componentStyle rectangle
title BC-02 Customer & Buyer Relationships — C4 L3 TARGET
legend bottom
  Component view inside the shared Nexa API modular monolith; no separate deployment is implied.
endlegend
package "Nexa API — logical BC-02 ownership" {
  component "Customer & Buyer Relationship API\n<<Interface>>" as api
  component "CreateCustomerAccountHandler\nApproveBuyerRelationshipHandler\nLinkBuyerIdentityHandler\n<<Application>>" as app
  component "CustomerAccount & BuyerRelationship\nEligibility Policies\n<<Domain>>" as domain
  component "Relationship Repositories & Tenant Scope Adapter\n<<Infrastructure>>" as infra
  database "Shared PostgreSQL\nBC-02 logical tables" as db
  component "Transactional Outbox\n<<Reliability>>" as outbox
}
component "BC-01 access / BC-03 and BC-04 contracts\n<<explicit contracts>>" as contracts
api --> app
app --> domain : approve, link, suspend
domain --> infra
infra --> db : logical ownership
app --> contracts : eligibility by reference
app --> outbox : committed facts
note bottom of domain
Customer Account != Human Identity; Buyer Relationship != Workforce Membership.
end note
@enduml
