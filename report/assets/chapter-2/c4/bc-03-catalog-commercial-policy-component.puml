@startuml
!theme plain
left to right direction
skinparam shadowing false
skinparam componentStyle rectangle
title BC-03 Catalog & Commercial Policy — C4 L3 TARGET
legend bottom
  Component view inside the shared Nexa API modular monolith; no separate deployment is implied.
endlegend
package "Nexa API — logical BC-03 ownership" {
  component "Catalog & Commercial Policy API\n<<Interface>>" as api
  component "ManageProductHandler\nResolveCatalogPriceHandler\nManagePriceListHandler\n<<Application>>" as app
  component "Product, SKU, Price List, Terms & Promotion\n<<Domain>>" as domain
  component "Catalog Repositories & Object Storage Port\n<<Infrastructure>>" as infra
  database "Shared PostgreSQL\nBC-03 logical tables" as db
  component "Transactional Outbox\n<<Reliability>>" as outbox
}
component "BC-02 eligibility / BC-04 offer snapshot\n<<explicit contracts>>" as contracts
api --> app
app --> domain : resolve authoritative offer
domain --> infra
infra --> db
app --> contracts : snapshots, not aggregates
app --> outbox : committed facts
note bottom of domain
Product != SKU; mutable policy does not rewrite a committed offer snapshot.
end note
@enduml
