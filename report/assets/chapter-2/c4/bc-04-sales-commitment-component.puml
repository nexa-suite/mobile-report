@startuml
!theme plain
left to right direction
skinparam shadowing false
skinparam componentStyle rectangle
title BC-04 Sales Commitment — C4 L3 TARGET
legend bottom
  Component view inside the shared Nexa API modular monolith; no separate deployment is implied.
endlegend
package "Nexa API — logical BC-04 ownership" {
  component "Sales Commitment API\n<<Interface>>" as api
  component "SubmitPurchaseRequestHandler\nConvertPurchaseRequestHandler\nConfirmDirectOrderHandler\n<<Application>>" as app
  component "Draft, Purchase Request, Commitment & Sales Order\n<<Domain>>" as domain
  component "Commitment Repositories, Idempotency & Outbox\n<<Infrastructure>>" as infra
  database "Shared PostgreSQL\nBC-04 logical tables" as db
}
component "BC-02, BC-03, BC-05 and BC-07\n<<synchronous decision contracts>>" as decisions
component "BC-06, BC-09, BC-10 and BC-11\n<<published fact consumers>>" as consumers
api --> app
app --> domain : decide lifecycle
domain --> infra
infra --> db
app --> decisions : validate / protect
infra --> consumers : post-commit outbox
note bottom of domain
Draft != PR != SO; Commitment != Backing != Physical Allocation.
end note
@enduml
