@startuml
!theme plain
left to right direction
skinparam shadowing false
skinparam componentStyle rectangle
title BC-06 Fulfillment & Delivery — C4 L3 TARGET
legend bottom
  Component view inside the shared Nexa API modular monolith; no separate deployment is implied.
endlegend
package "Nexa API — logical BC-06 ownership" {
  component "Fulfillment & Delivery API\n<<Interface>>" as api
  component "PlanFulfillmentHandler\nConfirmPickingHandler\nFinalizeDeliveryAttemptHandler\n<<Application>>" as app
  component "Fulfillment, Delivery, Attempt, POD & Continuation\n<<Domain>>" as domain
  component "Repositories, Evidence Port & Outbox\n<<Infrastructure>>" as infra
  database "Shared PostgreSQL\nBC-06 logical tables" as db
}
component "BC-04 order / BC-05 allocation\n<<synchronous contracts>>" as inputs
component "BC-09, BC-10 and BC-11\n<<post-commit consumers>>" as consumers
api --> app
app --> domain : execute lifecycle
domain --> infra
infra --> db
app --> inputs
infra --> consumers : durable facts
note bottom of domain
Dispatch Handoff != Driver Outcome != Buyer Receipt; POD is not a receipt.
end note
@enduml
