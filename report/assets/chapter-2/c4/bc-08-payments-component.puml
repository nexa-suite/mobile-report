@startuml
!theme plain
left to right direction
skinparam shadowing false
skinparam componentStyle rectangle
title BC-08 Payments — C4 L3 TARGET
legend bottom
  Component view inside the shared Nexa API modular monolith; no payment microservice is implied.
endlegend
package "Nexa API — logical BC-08 ownership" {
  component "Payment & Webhook API\n<<Interface>>" as api
  component "ReportPaymentHandler\nAcceptProviderWebhookHandler\nResolvePaymentReconciliationHandler\n<<Application>>" as app
  component "Payment, Provider Event & Reconciliation\n<<Domain>>" as domain
  component "Provider ACL, Repositories & Outbox\n<<Infrastructure>>" as infra
  database "Shared PostgreSQL\nBC-08 logical tables" as db
}
component "External Payment Provider\n<<external system>>" as provider
component "BC-07, BC-09, BC-10 and BC-11\n<<explicit consumers>>" as consumers
api --> app
app --> domain : provider-neutral decision
domain --> infra
infra --> db
infra --> provider : fenced external I/O
infra --> consumers : committed facts
note bottom of domain
Payment Reported != Payment Confirmed; webhook delivery is deduplicated.
end note
@enduml
