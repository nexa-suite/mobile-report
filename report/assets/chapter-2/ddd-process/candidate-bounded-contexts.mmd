  E09["Physical Allocation Executed"]:::event
  E08 --> A06 --> A07 --> E09
end

subgraph BC07["BC-07 — Credit & Receivables\nSupporting-aligned"]
direction TB
  A08["Credit Reservation"]:::object
  A09["Receivable"]:::object
  E10["Payment Applied"]:::event
  A08 --> A09 --> E10
end

subgraph BC06["BC-06 — Fulfillment & Delivery\nCORE-aligned"]
direction TB
  A10["Picking / Packing Work"]:::object
  E11["Ready for Dispatch"]:::event
  E12["Dispatch Handoff"]:::event
  E13["Delivery Attempted"]:::event
  A11["Proof of Delivery"]:::evidence
  E14["Buyer Receipt Recorded"]:::event
  E15["Partial Delivery Recorded"]:::event
  E16["Continuation Delivery Created"]:::event

  A10 --> E11 --> E12 --> E13 --> A11
  A11 --> E14
  A11 --> E15 --> E16
end

subgraph BC08["BC-08 — Payments\nGeneric-aligned"]
direction TB
  E17["Payment Reported"]:::event
  E18["Payment Confirmed"]:::event
  E17 --> E18
end

subgraph BC09["BC-09 — Business Documents\nGeneric-aligned"]
direction TB
  E19["Business Document Issued"]:::event
end

subgraph BC10["BC-10 — Notifications\nGeneric-aligned"]
direction TB
  A12["Notification Intent"]:::object
  E20["Notification Delivered / Failed"]:::event
  A12 --> E20
end

subgraph BC11["BC-11 — Business Traceability\nSupporting-aligned"]
direction TB
  E21["Business Fact Traced"]:::trace
end

