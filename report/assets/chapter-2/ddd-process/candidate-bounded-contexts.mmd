%% ==========================================================
%% NEXA — CANDIDATE BOUNDED CONTEXT DISCOVERY
%% Reference artifact for recreation in Miro.
%% Boundaries represent semantic/domain responsibility,
%% never deployment units, applications, schemas or services.
%% ==========================================================

classDef event fill:#F9A66C,stroke:#A84A00,stroke-width:1.4px,color:#111;
classDef object fill:#A9D6F5,stroke:#2B6F9F,stroke-width:1.3px,color:#111;
classDef decision fill:#F7E27D,stroke:#9A7B00,stroke-width:1.3px,color:#111;
classDef evidence fill:#C7E9C0,stroke:#4B8144,stroke-width:1.3px,color:#111;
classDef trace fill:#D8C9F2,stroke:#6B4EA1,stroke-width:1.3px,color:#111;

subgraph BC01["BC-01 — Tenant & Access Governance\nSupporting-aligned"]
direction TB
  A01["Onboarding Request"]:::object
  E01["Tenant Activated"]:::event
  E02["Workforce Membership Granted"]:::event
  A01 --> E01 --> E02
end

subgraph BC02["BC-02 — Customer & Buyer Relationships\nSupporting-aligned"]
direction TB
  A02["Customer Account"]:::object
  E03["Buyer Relationship Approved"]:::event
  A02 --> E03
end

subgraph BC03["BC-03 — Catalog & Commercial Policy\nSupporting-aligned"]
direction TB
  A03["Product / SKU"]:::object
  E04["Authoritative Price Resolved"]:::event
  A04["Offer Snapshot"]:::object
  A03 --> E04 --> A04
end

subgraph BC04["BC-04 — Sales Commitment\nCORE-aligned"]
direction TB
  A05["Sales Draft"]:::object
  E05["Purchase Request Submitted\nor Direct Order Confirmed"]:::event
  E06["Commercial Commitment Established"]:::event
  E07["Sales Order Confirmed"]:::event
  A05 --> E05 --> E06 --> E07
end

subgraph BC05["BC-05 — Inventory Availability\nCORE-aligned"]
direction TB
  E08["Commitment Demand Observed"]:::event
