flowchart LR
  classDef actor fill:#F7E27D,stroke:#9A7B00,stroke-width:1.3px,color:#111
  classDef work fill:#F9A66C,stroke:#A84A00,stroke-width:1.4px,color:#111

  salesApplication((Nexa Sales Application)):::actor
  inventoryApplication((Nexa Inventory Application)):::actor
  operator((Warehouse Operator)):::actor
  coordinator((Fulfillment Coordinator)):::actor

  subgraph bc04["BC-04 Sales Commitment"]
    order["Confirmed Sales Order"]:::work
    commitment["Commercial Commitment"]:::work
  end

  subgraph bc05["BC-05 Inventory Availability"]
    reservation["Existing Inventory Reservation"]:::work
    backing["Existing Warehouse Backing"]:::work
    lot["Inventory Lot"]:::work
    allocation["Physical Allocation"]:::work
  end

  subgraph bc06["BC-06 Fulfillment & Delivery"]
    picking["Picking Work"]:::work
    packed["Packed Goods"]:::work
    handoff["Dispatch Handoff"]:::work
  end

  salesApplication -->|1. makes available| order
  order -->|confirmed demand| commitment
  inventoryApplication -->|2. uses existing protection| reservation
  reservation -->|existing backing| backing
  operator -->|3. verifies| lot
  inventoryApplication -->|4. selects eligible lots| allocation
  backing -->|authorizes selection| allocation
  lot -->|FEFO eligibility| allocation
  coordinator -->|5. creates| picking
  allocation -->|stable allocation ID| picking
  operator -->|6. prepares| packed
  coordinator -->|7. hands over| handoff

  style bc04 fill:none,stroke:#6B7280,stroke-width:1px
  style bc05 fill:none,stroke:#6B7280,stroke-width:1px
  style bc06 fill:none,stroke:#6B7280,stroke-width:1px
