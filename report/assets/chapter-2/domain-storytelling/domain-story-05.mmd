flowchart LR
  classDef actor fill:#F7E27D,stroke:#9A7B00,stroke-width:1.3px,color:#111
  classDef work fill:#F9A66C,stroke:#A84A00,stroke-width:1.4px,color:#111

  buyer((Customer Buyer)):::actor
  provider((Payment Provider)):::actor
  finance((Finance Operator)):::actor
  documentsApplication((Nexa Documents Application)):::actor
  notificationsApplication((Nexa Notifications Application)):::actor
  traceabilityApplication((Nexa Traceability Application)):::actor

  subgraph bc08["BC-08 Payments"]
    reported["Payment Reported"]:::work
    providerResult["Provider Result"]:::work
    confirmed["Payment Confirmed"]:::work
  end

  subgraph bc07["BC-07 Credit & Receivables"]
    application["Payment Application"]:::work
    receivable["Receivable"]:::work
  end

  subgraph bc09["BC-09 Business Documents"]
    document["Business Document"]:::work
  end

  subgraph bc10["BC-10 Notifications"]
    notification["Notification"]:::work
  end

  subgraph bc11["BC-11 Business Traceability"]
    trace["Business Traceability Record"]:::work
  end

  buyer -->|1. reports or initiates| reported
  provider -->|2. returns| providerResult
  finance -->|3. verifies and deduplicates| confirmed
  reported -->|awaits verification| confirmed
  providerResult -->|translated result| confirmed
  finance -->|4. applies| application
  confirmed -->|stable payment reference| application
  application -->|updates| receivable
  documentsApplication -->|5. issues| document
  application -->|valid source fact| document
  notificationsApplication -->|6. creates| notification
  confirmed -->|confirmed fact| notification
  traceabilityApplication -->|7. appends| trace
  confirmed -->|payment fact| trace
  application -->|financial fact| trace

  style bc07 fill:none,stroke:#6B7280,stroke-width:1px
  style bc08 fill:none,stroke:#6B7280,stroke-width:1px
  style bc09 fill:none,stroke:#6B7280,stroke-width:1px
  style bc10 fill:none,stroke:#6B7280,stroke-width:1px
  style bc11 fill:none,stroke:#6B7280,stroke-width:1px
