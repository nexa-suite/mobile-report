@startuml
title BC-01 Tenant & Access Governance — Logical Database Design
left to right direction
hide methods
skinparam shadowing false
skinparam linetype ortho
skinparam entity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
}

entity "tenant" as tenant {
  * tenant_id : uuid <<PK>>
  * legal_name : varchar(200) <<required>>
  * slug : varchar(100) <<required, unique>>
  * status : varchar(32) <<required>>
  * version : integer <<required>>
  * created_at : timestamptz <<required>>
  * updated_at : timestamptz <<required>>
}

entity "workspace" as workspace {
  * workspace_id : uuid <<PK>>
  * tenant_id : uuid <<FK, required, unique>>
  * slug : varchar(100) <<required>>
  * status : varchar(32) <<required>>
  * version : integer <<required>>
}

entity "human_identity" as human_identity {
  * human_identity_id : uuid <<PK>>
  * normalized_email : varchar(320) <<required, unique>>
    display_name : varchar(200)
  * status : varchar(32) <<required>>
    verified_at : timestamptz
}

entity "company_onboarding_request" as onboarding_request {
  * request_id : uuid <<PK>>
  * applicant_email : varchar(320) <<required>>
  * legal_name : varchar(200) <<required>>
    registration_number : varchar(80)
  * status : varchar(32) <<required>>
    provisioned_tenant_id : uuid <<FK, optional>>
    rejection_reason : varchar(500)
  * submitted_at : timestamptz <<required>>
    decided_at : timestamptz
  * version : integer <<required>>
}

entity "workforce_membership" as workforce_membership {
  * membership_id : uuid <<PK>>
  * workspace_id : uuid <<FK, required>>
  * human_identity_id : uuid <<FK, required>>
  * status : varchar(32) <<required>>
  * version : integer <<required>>
}

entity "role_definition" as role_definition {
  * role_id : uuid <<PK>>
  * tenant_id : uuid <<FK, required>>
  * code : varchar(80) <<required>>
  * status : varchar(32) <<required>>
  * version : integer <<required>>
}

entity "capability_definition" as capability_definition {
  * capability_id : uuid <<PK>>
  * code : varchar(120) <<required, unique>>
  * name : varchar(200) <<required>>
}

entity "membership_role" as membership_role {
  * membership_id : uuid <<FK, required>>
  * role_id : uuid <<FK, required>>
  * assigned_at : timestamptz <<required>>
}

entity "role_capability" as role_capability {
  * role_id : uuid <<FK, required>>
  * capability_id : uuid <<FK, required>>
}

entity "membership_capability_override" as capability_override {
  * override_id : uuid <<PK>>
  * membership_id : uuid <<FK, required>>
  * capability_id : uuid <<FK, required>>
  * effect : varchar(16) <<required>>
  * reason : varchar(500) <<required>>
}

workspace }o--|| tenant : tenant_id
onboarding_request }o--o| tenant : provisioned_tenant_id
workforce_membership }o--|| workspace : workspace_id
workforce_membership }o--|| human_identity : human_identity_id
role_definition }o--|| tenant : tenant_id
membership_role }o--|| workforce_membership : membership_id
membership_role }o--|| role_definition : role_id
role_capability }o--|| role_definition : role_id
role_capability }o--|| capability_definition : capability_id
capability_override }o--|| workforce_membership : membership_id
capability_override }o--|| capability_definition : capability_id

legend right
workspace.tenant_id is unique and enforces Tenant 1:1 Workspace.
Company onboarding starts without a Tenant; provisioned_tenant_id is optional.
PK = primary key | FK = local reference | required = NOT NULL
endlegend
@enduml
