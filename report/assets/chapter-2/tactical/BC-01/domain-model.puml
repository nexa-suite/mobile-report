@startuml BC01_TenantAccessGovernance
title BC-01 Tenant & Access Governance — Tactical Domain Model
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class Tenant <<Aggregate Root>> {
  -tenantId: TenantId
  -name: TenantName
  -status: TenantStatus
  -version: Version
  +activate(): void
  +suspend(reason: SuspensionReason): void
}

class Workspace <<Entity>> {
  -workspaceId: WorkspaceId
  -slug: WorkspaceSlug
  -status: WorkspaceStatus
  +rename(slug: WorkspaceSlug): void
  +activate(): void
}

class HumanIdentity <<Aggregate Root>> {
  -humanIdentityId: HumanIdentityId
  -email: EmailAddress
  -status: IdentityStatus
  +verify(): void
  +disable(reason: DisableReason): void
}

class WorkforceMembership <<Aggregate Root>> {
  -membershipId: MembershipId
  -workspaceId: WorkspaceId
  -humanIdentityId: HumanIdentityId
  -status: MembershipStatus
  +invite(): void
  +activate(): void
  +revoke(reason: RevokeReason): void
  +can(capability: CapabilityCode): boolean
}

class RoleDefinition <<Aggregate Root>> {
  -roleId: RoleId
  -tenantId: TenantId
  -code: RoleCode
  -status: RoleStatus
  +assignCapability(capability: CapabilityCode): void
  +retire(): void
}

class CompanyOnboardingRequest <<Aggregate Root>> {
  -requestId: OnboardingRequestId
  -company: CompanyInformation
  -applicantEmail: EmailAddress
  -status: OnboardingStatus
  -provisionedTenantId: TenantId [0..1]
  +submit(): void
  +approve(): void
  +reject(reason: RejectionReason): void
}

class MembershipRole <<Entity>> {
  -roleId: RoleId
  -assignedAt: Instant
  +remove(): void
}

class RoleCapability <<Entity>> {
  -capability: CapabilityCode
  +grant(): void
  +revoke(): void
}

class MembershipCapabilityOverride <<Entity>> {
  -capability: CapabilityCode
  -effect: CapabilityEffect
  +allow(): void
  +deny(): void
}

class CompanyInformation <<Value Object>> {
  -registeredName: String
  -taxIdentity: String
  -contact: ContactInformation
}

class AccessContext <<Value Object>> {
  -tenantId: TenantId
  -workspaceId: WorkspaceId
  -membershipId: MembershipId
  +requireCapability(code: CapabilityCode): void
}

class CapabilityCode <<Value Object>> {
  -value: String
}

class AccessEligibilityPolicy <<Domain Policy>> {
  +evaluate(context: AccessContext, capability: CapabilityCode): boolean
}

interface TenantRepository <<Repository>> {
  +byId(id: TenantId): Tenant
  +save(tenant: Tenant): void
}

interface HumanIdentityRepository <<Repository>> {
  +byId(id: HumanIdentityId): HumanIdentity
  +save(identity: HumanIdentity): void
}

interface WorkforceMembershipRepository <<Repository>> {
  +byId(id: MembershipId): WorkforceMembership
  +save(membership: WorkforceMembership): void
}

interface RoleDefinitionRepository <<Repository>> {
  +byId(id: RoleId): RoleDefinition
  +save(role: RoleDefinition): void
}

interface CompanyOnboardingRequestRepository <<Repository>> {
  +byId(id: OnboardingRequestId): CompanyOnboardingRequest
  +save(request: CompanyOnboardingRequest): void
}

class TenantActivated <<Domain Event>> {
  -tenantId: TenantId
  -workspaceId: WorkspaceId
  -occurredAt: Instant
}

enum TenantStatus <<Enum>>
enum WorkspaceStatus <<Enum>>
enum IdentityStatus <<Enum>>
enum MembershipStatus <<Enum>>
enum RoleStatus <<Enum>>
enum OnboardingStatus <<Enum>>
enum CapabilityEffect <<Enum>>

Tenant "1" *-- "1" Workspace : owns
WorkforceMembership "1" *-- "0..*" MembershipRole : role assignments
WorkforceMembership "1" *-- "0..*" MembershipCapabilityOverride : overrides
RoleDefinition "1" *-- "0..*" RoleCapability : capabilities
WorkforceMembership --> Workspace : workspaceId
WorkforceMembership --> HumanIdentity : humanIdentityId
MembershipRole --> RoleDefinition : roleId
CompanyOnboardingRequest --> Tenant : provisionedTenantId [0..1]
TenantRepository ..> Tenant : persists
HumanIdentityRepository ..> HumanIdentity : persists
WorkforceMembershipRepository ..> WorkforceMembership : persists
RoleDefinitionRepository ..> RoleDefinition : persists
CompanyOnboardingRequestRepository ..> CompanyOnboardingRequest : persists
AccessEligibilityPolicy --> AccessContext : evaluates
AccessEligibilityPolicy --> CapabilityCode : checks
Tenant ..> TenantActivated : emits

legend right
Aggregate Roots keep independent consistency boundaries.
Workspace is a Tenant-owned Entity; CompanyOnboardingRequest precedes Tenant.
Root-to-root and cross-context links use identity references.
*-- composition | --> reference or dependency | ..> repository use
endlegend
@enduml
