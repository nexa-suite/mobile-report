@startuml
title BC-02 Customer & Buyer Relationships — Logical Database Design
left to right direction
hide methods
skinparam shadowing false
skinparam linetype ortho
skinparam entity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
}

entity "customer_account" as customer_account {
  * customer_account_id : uuid <<PK>>
  * tenant_id : uuid <<required, BC-01 ID>>
  * workspace_id : uuid <<required, BC-01 ID>>
  * legal_name : varchar(200) <<required>>
    tax_identifier : varchar(80)
  * status : varchar(32) <<required>>
  * version : integer <<required>>
}

entity "customer_contact" as customer_contact {
  * contact_id : uuid <<PK>>
  * customer_account_id : uuid <<FK, required>>
    human_identity_id : uuid <<BC-01 ID, optional>>
  * role : varchar(32) <<required>>
  * status : varchar(32) <<required>>
}

entity "customer_address" as customer_address {
  * address_id : uuid <<PK>>
  * customer_account_id : uuid <<FK, required>>
  * kind : varchar(32) <<required>>
  * line1 : varchar(240) <<required>>
    locality : varchar(120)
    recipient_name : varchar(200)
    is_default : boolean <<required>>
}

entity "buyer_relationship" as buyer_relationship {
  * relationship_id : uuid <<PK>>
  * tenant_id : uuid <<required, BC-01 ID>>
  * customer_account_id : uuid <<FK, required>>
  * human_identity_id : uuid <<required, BC-01 ID>>
  * status : varchar(32) <<required>>
  * requested_at : timestamptz <<required>>
    approved_at : timestamptz
    revoked_at : timestamptz
  * version : integer <<required>>
}

entity "buyer_relationship_history" as relationship_history {
  * history_id : uuid <<PK>>
  * relationship_id : uuid <<FK, required>>
    from_status : varchar(32)
  * to_status : varchar(32) <<required>>
    changed_by_identity_id : uuid <<BC-01 ID>>
  * changed_at : timestamptz <<required>>
}

customer_contact }o--|| customer_account : customer_account_id
customer_address }o--|| customer_account : customer_account_id
buyer_relationship }o--|| customer_account : customer_account_id
relationship_history }o--|| buyer_relationship : relationship_id

legend right
CustomerAccount and BuyerRelationship retain separate root lifecycles.
Tenant, Workspace and HumanIdentity are typed BC-01 references, not local FKs.
PK = primary key | FK = local reference | required = NOT NULL
endlegend
@enduml
