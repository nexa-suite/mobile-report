@startuml BC02_CustomerBuyerRelationships
title BC-02 Customer & Buyer Relationships — Tactical Domain Model
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class CustomerAccount <<Aggregate Root>> {
  -customerAccountId: CustomerAccountId
  -tenantId: TenantId
  -legalName: LegalName
  -status: CustomerStatus
  +open(): void
  +suspend(reason: SuspensionReason): void
  +changeLegalName(name: LegalName): void
}

class BuyerRelationship <<Aggregate Root>> {
  -relationshipId: BuyerRelationshipId
  -tenantId: TenantId
  -customerAccountId: CustomerAccountId
  -humanIdentityId: HumanIdentityId
  -status: RelationshipStatus
  +request(): void
  +approve(): void
  +suspend(reason: SuspensionReason): void
  +revoke(reason: RevokeReason): void
}

class CustomerContact <<Entity>> {
  -contactId: CustomerContactId
  -humanIdentityId: HumanIdentityId [0..1]
  -role: ContactRole
  +designateAsBuyer(): void
  +remove(): void
}

class CustomerAddress <<Entity>> {
  -addressId: CustomerAddressId
  -kind: AddressKind
  -snapshot: AddressSnapshot
  +replace(snapshot: AddressSnapshot): void
  +retire(): void
}

class BuyerRelationshipHistory <<Entity>> {
  -historyId: RelationshipHistoryId
  -fromStatus: RelationshipStatus
  -toStatus: RelationshipStatus
  -changedAt: Instant
  +recordTransition(): void
}

class AddressSnapshot <<Value Object>> {
  -line1: String
  -locality: String
  -coordinates: Coordinates
  -instructions: String
}

class BuyerEligibilityPolicy <<Domain Policy>> {
  +canPurchase(relationship: BuyerRelationship, context: AccessContext): boolean
}

interface CustomerAccountRepository <<Repository>> {
  +byId(id: CustomerAccountId): CustomerAccount
  +save(account: CustomerAccount): void
}

interface BuyerRelationshipRepository <<Repository>> {
  +byId(id: BuyerRelationshipId): BuyerRelationship
  +save(relationship: BuyerRelationship): void
}

class BuyerRelationshipApproved <<Domain Event>> {
  -relationshipId: BuyerRelationshipId
  -customerAccountId: CustomerAccountId
  -occurredAt: Instant
}

enum CustomerStatus <<Enum>>
enum RelationshipStatus <<Enum>>
enum ContactRole <<Enum>>
enum AddressKind <<Enum>>

CustomerAccount "1" *-- "0..*" CustomerContact : contacts
CustomerAccount "1" *-- "0..*" CustomerAddress : addresses
BuyerRelationship "1" *-- "0..*" BuyerRelationshipHistory : immutable history
BuyerRelationship --> CustomerAccount : customerAccountId
CustomerContact --> HumanIdentityId : typed external ID
BuyerRelationship --> HumanIdentityId : typed external ID
CustomerAddress *-- AddressSnapshot : address data
BuyerEligibilityPolicy --> BuyerRelationship : evaluates
BuyerEligibilityPolicy --> AccessContext : evaluates
CustomerAccountRepository ..> CustomerAccount : persists
BuyerRelationshipRepository ..> BuyerRelationship : persists
BuyerRelationship ..> BuyerRelationshipApproved : emits

legend right
CustomerAccount and BuyerRelationship are separate Aggregate Roots.
HumanIdentity belongs to BC-01 and is referenced by typed ID.
BuyerRelationshipHistory is immutable and owned by its relationship.
*-- composition | --> reference or dependency | ..> repository use
endlegend
@enduml
