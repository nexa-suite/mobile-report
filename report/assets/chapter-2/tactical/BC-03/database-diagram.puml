@startuml
title BC-03 Catalog & Commercial Policy — Logical Database Design
left to right direction
hide methods
skinparam shadowing false
skinparam linetype ortho
skinparam entity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
}

entity "product" as product {
  * product_id : uuid <<PK>>
  * tenant_id : uuid <<required, BC-01 ID>>
  * code : varchar(80) <<required, unique>>
  * name : varchar(200) <<required>>
  * status : varchar(32) <<required>>
  * version : integer <<required>>
}

entity "sku" as sku {
  * sku_id : uuid <<PK>>
  * product_id : uuid <<FK, required>>
  * code : varchar(80) <<required, unique>>
  * temperature_band : varchar(64) <<required>>
  * status : varchar(32) <<required>>
  * version : integer <<required>>
}

entity "catalog_media_reference" as catalog_media {
  * media_id : uuid <<PK>>
  * product_id : uuid <<FK, required>>
  * object_reference : varchar(500) <<required>>
  * media_kind : varchar(32) <<required>>
}

entity "price_list" as price_list {
  * price_list_id : uuid <<PK>>
  * tenant_id : uuid <<required, BC-01 ID>>
  * currency : char(3) <<required>>
  * status : varchar(32) <<required>>
  * version : integer <<required>>
}

entity "price_list_item" as price_list_item {
  * item_id : uuid <<PK>>
  * price_list_id : uuid <<FK, required>>
  * sku_id : uuid <<FK, required>>
  * unit_price : numeric(19,4) <<required>>
  * currency : char(3) <<required>>
  * valid_from : timestamptz <<required>>
    valid_to : timestamptz
}

entity "customer_terms" as customer_terms {
  * terms_id : uuid <<PK>>
  * tenant_id : uuid <<required, BC-01 ID>>
  * customer_account_id : uuid <<required, BC-02 ID>>
    price_list_id : uuid <<FK, optional>>
  * credit_days : integer <<required>>
  * valid_from : timestamptz <<required>>
    valid_to : timestamptz
}

entity "promotion" as promotion {
  * promotion_id : uuid <<PK>>
  * tenant_id : uuid <<required, BC-01 ID>>
  * code : varchar(80) <<required>>
  * status : varchar(32) <<required>>
  * starts_at : timestamptz <<required>>
  * ends_at : timestamptz <<required>>
  * version : integer <<required>>
}

entity "promotion_sku" as promotion_sku {
  * promotion_sku_id : uuid <<PK>>
  * promotion_id : uuid <<FK, required>>
  * sku_id : uuid <<FK, required>>
  * discount_kind : varchar(32) <<required>>
  * discount_value : numeric(19,4) <<required>>
}

sku }o--|| product : product_id
catalog_media }o--|| product : product_id
price_list_item }o--|| price_list : price_list_id
price_list_item }o--|| sku : sku_id
customer_terms }o--o| price_list : price_list_id
promotion_sku }o--|| promotion : promotion_id
promotion_sku }o--|| sku : sku_id

legend right
Product and SKU are separate roots despite a local identity reference.
CustomerAccount is a typed BC-02 reference; it is deliberately not an FK.
Offer policy selects at most one eligible promotion for a snapshot.
PK = primary key | FK = local reference | required = NOT NULL
endlegend
@enduml
