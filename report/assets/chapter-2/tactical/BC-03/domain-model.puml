@startuml BC03_CatalogCommercialPolicy
title BC-03 Catalog & Commercial Policy — Tactical Domain Model
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class Product <<Aggregate Root>> {
  -productId: ProductId
  -tenantId: TenantId
  -name: ProductName
  -status: ProductStatus
  +create(): void
  +publish(): void
  +retire(): void
}

class SKU <<Aggregate Root>> {
  -skuId: SkuId
  -productId: ProductId
  -code: SkuCode
  -temperatureBand: TemperatureBand
  -status: SkuStatus
  +activate(): void
  +changePresentation(presentation: SkuPresentation): void
  +discontinue(): void
}

class PriceList <<Aggregate Root>> {
  -priceListId: PriceListId
  -tenantId: TenantId
  -currency: CurrencyCode
  -status: PriceListStatus
  +activate(): void
  +replaceItem(item: PriceListItem): void
}

class CustomerTerms <<Aggregate Root>> {
  -termsId: CustomerTermsId
  -customerAccountId: CustomerAccountId
  -priceListId: PriceListId
  -creditDays: Integer
  +amend(creditDays: Integer): void
}

class Promotion <<Aggregate Root>> {
  -promotionId: PromotionId
  -tenantId: TenantId
  -validity: TimeWindow
  -status: PromotionStatus
  +schedule(): void
  +activate(): void
  +expire(): void
}

class CatalogMediaReference <<Entity>> {
  -mediaId: CatalogMediaId
  -objectReference: ObjectStorageReference
  +attach(): void
  +detach(): void
}

class PriceListItem <<Entity>> {
  -itemId: PriceListItemId
  -skuId: SkuId
  -unitPrice: Money
  -validity: TimeWindow
  +changePrice(price: Money): void
}

class PromotionSku <<Entity>> {
  -skuId: SkuId
  -discount: Discount
  +include(): void
  +exclude(): void
}

class ResolvedOfferSnapshot <<Value Object>> {
  -skuId: SkuId
  -unitPrice: Money
  -termsId: CustomerTermsId [0..1]
  -promotionId: PromotionId [0..1]
}

class Money <<Value Object>> {
  -amount: Decimal
  -currency: CurrencyCode
}

class TimeWindow <<Value Object>> {
  -startsAt: Instant
  -endsAt: Instant
}

class OfferResolutionPolicy <<Domain Policy>> {
  +resolve(sku: SKU, prices: PriceListItem, terms: CustomerTerms, promotion: Promotion [0..1]): ResolvedOfferSnapshot
}

interface PriceListRepository <<Repository>> {
  +byId(id: PriceListId): PriceList
  +save(priceList: PriceList): void
}

interface ProductRepository <<Repository>> {
  +byId(id: ProductId): Product
  +save(product: Product): void
}

interface SKURepository <<Repository>> {
  +byId(id: SkuId): SKU
  +save(sku: SKU): void
}

interface CustomerTermsRepository <<Repository>> {
  +byId(id: CustomerTermsId): CustomerTerms
  +save(terms: CustomerTerms): void
}

interface PromotionRepository <<Repository>> {
  +byId(id: PromotionId): Promotion
  +save(promotion: Promotion): void
}

enum ProductStatus <<Enum>>
enum SkuStatus <<Enum>>
enum PriceListStatus <<Enum>>
enum PromotionStatus <<Enum>>

Product "1" *-- "0..*" CatalogMediaReference : media references
PriceList "1" *-- "0..*" PriceListItem : effective items
Promotion "1" *-- "0..*" PromotionSku : scope
SKU --> Product : productId
PriceListItem --> SKU : skuId
PromotionSku --> SKU : skuId
CustomerTerms --> PriceList : priceListId
CustomerTerms --> CustomerAccountId : typed BC-02 ID
OfferResolutionPolicy --> ResolvedOfferSnapshot : produces
OfferResolutionPolicy --> Promotion : selects at most one
ProductRepository ..> Product : persists
PriceListRepository ..> PriceList : persists
SKURepository ..> SKU : persists
CustomerTermsRepository ..> CustomerTerms : persists
PromotionRepository ..> Promotion : persists

legend right
Product and SKU are independent Aggregate Roots linked by identity.
PriceList owns pricing items; Promotion policy selects at most one promotion.
CustomerAccount is a typed BC-02 reference; no cross-context composition.
*-- composition | --> reference or dependency | ..> repository use
endlegend
@enduml
