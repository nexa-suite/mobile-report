@startuml
title BC-04 Sales Commitment — Logical Database Design
left to right direction
skinparam shadowing false
skinparam linetype ortho
skinparam entity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
}

entity "request_draft" as request_draft {
  * draft_id : uuid <<PK>>
  * tenant_id : uuid <<required, BC-01 ID>>
  * buyer_relationship_id : uuid <<required, BC-02 ID>>
  * status : varchar(32) <<required>>
    expires_at : timestamptz
  * version : integer <<required>>
}

entity "request_draft_line" as request_draft_line {
  * line_id : uuid <<PK>>
  * draft_id : uuid <<FK, required>>
  * sku_id : uuid <<required, BC-03 ID>>
  * quantity : numeric(19,6) <<required, > 0>>
}

entity "purchase_request" as purchase_request {
  * purchase_request_id : uuid <<PK>>
  * tenant_id : uuid <<required, BC-01 ID>>
  * buyer_relationship_id : uuid <<required, BC-02 ID>>
  * status : varchar(32) <<required>>
  * submitted_at : timestamptz <<required>>
  * expires_at : timestamptz <<required>>
  * version : integer <<required>>
}

entity "purchase_request_line" as purchase_request_line {
  * line_id : uuid <<PK>>
  * purchase_request_id : uuid <<FK, required>>
  * sku_id : uuid <<required, BC-03 ID>>
  * requested_quantity : numeric(19,6) <<required, > 0>>
  * terms_snapshot : jsonb <<required>>
}

entity "material_change_proposal" as material_change_proposal {
  * proposal_id : uuid <<PK>>
  * purchase_request_id : uuid <<FK, required>>
  * status : varchar(32) <<required>>
  * change_snapshot : jsonb <<required>>
  * proposed_at : timestamptz <<required>>
    decided_at : timestamptz
}

entity "commercial_commitment" as commercial_commitment {
  * commitment_id : uuid <<PK>>
  * tenant_id : uuid <<required, BC-01 ID>>
  * buyer_relationship_id : uuid <<required, BC-02 ID>>
  * origin_type : varchar(32) <<required>>
    purchase_request_id : uuid <<FK, optional>>
  * status : varchar(32) <<required>>
  * committed_at : timestamptz <<required>>
  * version : integer <<required>>
}

entity "commercial_commitment_line" as commercial_commitment_line {
  * line_id : uuid <<PK>>
  * commitment_id : uuid <<FK, required>>
  * sku_id : uuid <<required, BC-03 ID>>
  * quantity : numeric(19,6) <<required, > 0>>
  * offer_snapshot : jsonb <<required>>
}

entity "commitment_adjustment" as commitment_adjustment {
  * adjustment_id : uuid <<PK>>
  * commitment_id : uuid <<FK, required>>
  * reason : varchar(500) <<required>>
  * quantity_delta : numeric(19,6) <<required>>
  * recorded_at : timestamptz <<required>>
}

entity "sales_order" as sales_order {
  * sales_order_id : uuid <<PK>>
  * tenant_id : uuid <<required, BC-01 ID>>
  * commitment_id : uuid <<required, BC-04 ID>>
  * status : varchar(32) <<required>>
  * confirmed_at : timestamptz <<required>>
  * version : integer <<required>>
}

entity "sales_order_line" as sales_order_line {
  * line_id : uuid <<PK>>
  * sales_order_id : uuid <<FK, required>>
  * sku_id : uuid <<required, BC-03 ID>>
  * quantity : numeric(19,6) <<required, > 0>>
  * unit_price : numeric(19,4) <<required, >= 0>>
  * currency : char(3) <<required>>
}

request_draft_line }o--|| request_draft : draft_id
purchase_request_line }o--|| purchase_request : purchase_request_id
material_change_proposal }o--|| purchase_request : purchase_request_id
commercial_commitment }o--o| purchase_request : purchase_request_id
commercial_commitment_line }o--|| commercial_commitment : commitment_id
commitment_adjustment }o--|| commercial_commitment : commitment_id
sales_order_line }o--|| sales_order : sales_order_id

note bottom of commercial_commitment
CHECK: origin_type = PURCHASE_REQUEST iff purchase_request_id is present.
DIRECT_ORDER carries no Purchase Request reference.
Line quantities are positive; price cannot be negative.
end note

legend right
PK = primary key | FK = local foreign key | required = NOT NULL.
Tenant, buyer relationship and SKU columns are typed cross-context IDs.
SalesOrder retains its own root identity through commitment_id.
endlegend
@enduml
