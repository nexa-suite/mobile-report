@startuml BC04_SalesCommitment
title BC-04 Sales Commitment — Tactical Domain Model
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class RequestDraft <<Aggregate Root>> {
  -draftId: RequestDraftId
  -tenantId: TenantId
  -buyerRelationshipId: BuyerRelationshipId
  -status: DraftStatus
  +addLine(skuId: SkuId, quantity: Quantity): void
  +submit(): PurchaseRequest
}

class RequestDraftLine <<Entity>> {
  -lineId: DraftLineId
  -skuId: SkuId
  -quantity: Quantity
  +changeQuantity(quantity: Quantity): void
}

class PurchaseRequest <<Aggregate Root>> {
  -purchaseRequestId: PurchaseRequestId
  -buyerRelationshipId: BuyerRelationshipId
  -status: PurchaseRequestStatus
  -expiresAt: Instant
  +submit(): void
  +acceptMaterialChange(proposalId: ProposalId): void
  +reject(reason: RejectionReason): void
}

class PurchaseRequestLine <<Entity>> {
  -lineId: PurchaseRequestLineId
  -skuId: SkuId
  -quantity: Quantity
  -termsSnapshot: TermsSnapshot
}

class MaterialChangeProposal <<Entity>> {
  -proposalId: ProposalId
  -changeSnapshot: CommercialSnapshot
  -status: ProposalStatus
  +accept(): void
  +reject(): void
}

class CommercialCommitment <<Aggregate Root>> {
  -commitmentId: CommitmentId
  -origin: CommitmentOrigin
  -purchaseRequestId: PurchaseRequestId [0..1]
  -status: CommitmentStatus
  +establishFromPurchaseRequest(requestId: PurchaseRequestId): void
  +establishDirectOrder(): void
  +cancel(reason: CancellationReason): void
}

class CommercialCommitmentLine <<Entity>> {
  -lineId: CommitmentLineId
  -skuId: SkuId
  -quantity: Quantity
  -offerSnapshot: CommercialSnapshot
}

class SalesOrder <<Aggregate Root>> {
  -salesOrderId: SalesOrderId
  -commitmentId: CommitmentId
  -status: SalesOrderStatus
  +confirm(): void
  +cancel(reason: CancellationReason): void
}

class SalesOrderLine <<Entity>> {
  -lineId: SalesOrderLineId
  -skuId: SkuId
  -quantity: Quantity
  -unitPrice: Money
}

class CommitmentAdjustment <<Entity>> {
  -adjustmentId: AdjustmentId
  -reason: AdjustmentReason
  -delta: QuantityDelta
  +record(): void
}

class TermsSnapshot <<Value Object>> {
  -unitPrice: Money
  -currency: CurrencyCode
  -creditDays: Integer
  -capturedAt: Instant
}

class CommercialSnapshot <<Value Object>> {
  -skuId: SkuId
  -unitPrice: Money
  -terms: TermsSnapshot
}

class InventoryReservationDecision <<Value Object>> {
  -reservationId: InventoryReservationId
  -status: ReservationStatus
}

class CreditReservationDecision <<Value Object>> {
  -creditReservationId: CreditReservationId
  -approved: Boolean
}

class CommitmentAcceptancePolicy <<Domain Policy>> {
  +canCommit(inventory: InventoryReservationDecision, credit: CreditReservationDecision): boolean
  +requiresBuyerAcceptance(change: MaterialChangeProposal): boolean
}

enum CommitmentOrigin <<Enum>> {
  PURCHASE_REQUEST
  DIRECT_ORDER
}

RequestDraft "1" *-- "0..*" RequestDraftLine : lines
PurchaseRequest "1" *-- "1..*" PurchaseRequestLine : lines
PurchaseRequest "1" *-- "0..*" MaterialChangeProposal : proposals
CommercialCommitment "1" *-- "1..*" CommercialCommitmentLine : lines
CommercialCommitment "1" *-- "0..*" CommitmentAdjustment : adjustments
SalesOrder "1" *-- "1..*" SalesOrderLine : lines
PurchaseRequestLine *-- TermsSnapshot : snapshot
CommercialCommitmentLine *-- CommercialSnapshot : snapshot
RequestDraft --> BuyerRelationshipId : typed BC-02 ID
PurchaseRequest --> BuyerRelationshipId : typed BC-02 ID
CommercialCommitment --> PurchaseRequestId : optional identity reference
SalesOrder --> CommitmentId : typed root ID
CommercialCommitment --> InventoryReservationDecision : published contract
CommercialCommitment --> CreditReservationDecision : published contract
CommitmentAcceptancePolicy --> InventoryReservationDecision : pure rule
CommitmentAcceptancePolicy --> CreditReservationDecision : pure rule
RequestDraft -[hidden]down-> PurchaseRequest
PurchaseRequest -[hidden]down-> CommercialCommitment
CommercialCommitment -[hidden]down-> SalesOrder

note right of CommercialCommitment
PURCHASE_REQUEST requires purchaseRequestId.
DIRECT_ORDER requires no PurchaseRequest.
end note

@enduml
