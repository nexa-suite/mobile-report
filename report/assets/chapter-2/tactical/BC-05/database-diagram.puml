@startuml
title BC-05 Inventory Availability — Logical Database Design
left to right direction
skinparam shadowing false
skinparam linetype ortho
skinparam entity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
}

entity "warehouse" as warehouse {
  * warehouse_id : uuid <<PK>>
  * tenant_id : uuid <<required, BC-01 ID>>
  * code : varchar(80) <<required>>
  * status : varchar(32) <<required>>
  * version : integer <<required>>
    unique(tenant_id, code)
}

entity "safety_stock_policy" as safety_stock_policy {
  * policy_id : uuid <<PK>>
  * warehouse_id : uuid <<FK, required>>
  * sku_id : uuid <<required, BC-03 ID>>
  * minimum_quantity : numeric(19,6) <<required, >= 0>>
}

entity "inventory_position" as inventory_position {
  * position_id : uuid <<PK>>
  * warehouse_id : uuid <<FK, required>>
  * sku_id : uuid <<required, BC-03 ID>>
  * usable_on_hand_quantity : numeric(19,6) <<required, >= 0>>
  * active_reservation_quantity : numeric(19,6) <<required, reconciled, >= 0>>
  * version : integer <<required>>
    unique(warehouse_id, sku_id)
}

entity "inventory_movement" as inventory_movement {
  * movement_id : uuid <<PK>>
  * position_id : uuid <<FK, required>>
    lot_id : uuid <<FK, optional>>
  * kind : varchar(32) <<required>>
  * quantity : numeric(19,6) <<required, <> 0>>
  * occurred_at : timestamptz <<required>>
  * reference_type : varchar(80) <<required>>
  * reference_id : uuid <<required>>
}

entity "inventory_lot" as inventory_lot {
  * lot_id : uuid <<PK>>
  * warehouse_id : uuid <<FK, required>>
  * sku_id : uuid <<required, BC-03 ID>>
  * lot_code : varchar(120) <<required>>
    expires_at : timestamptz
  * on_hand_quantity : numeric(19,6) <<required, >= 0>>
  * status : varchar(32) <<required>>
  * version : integer <<required>>
}

entity "lot_disposition" as lot_disposition {
  * disposition_id : uuid <<PK>>
  * lot_id : uuid <<FK, required>>
  * kind : varchar(32) <<required>>
  * reason : varchar(500) <<required>>
  * recorded_at : timestamptz <<required>>
}

entity "inventory_reservation" as inventory_reservation {
  * reservation_id : uuid <<PK>>
  * tenant_id : uuid <<required, BC-01 ID>>
  * commercial_commitment_id : uuid <<required, BC-04 ID>>
  * status : varchar(32) <<required>>
  * version : integer <<required>>
}

entity "inventory_reservation_line" as inventory_reservation_line {
  * line_id : uuid <<PK>>
  * reservation_id : uuid <<FK, required>>
  * sku_id : uuid <<required, BC-03 ID>>
  * quantity : numeric(19,6) <<required, > 0>>
}

entity "warehouse_backing" as warehouse_backing {
  * backing_id : uuid <<PK>>
  * reservation_id : uuid <<required, BC-05 ID>>
  * status : varchar(32) <<required>>
  * version : integer <<required>>
}

entity "warehouse_backing_line" as warehouse_backing_line {
  * line_id : uuid <<PK>>
  * backing_id : uuid <<FK, required>>
  * warehouse_id : uuid <<FK, required>>
  * sku_id : uuid <<required, BC-03 ID>>
  * quantity : numeric(19,6) <<required, > 0>>
}

entity "physical_allocation" as physical_allocation {
  * allocation_id : uuid <<PK>>
  * backing_id : uuid <<required, BC-05 ID>>
  * fulfillment_id : uuid <<required, BC-06 ID>>
  * status : varchar(32) <<required>>
  * version : integer <<required>>
}

entity "physical_allocation_line" as physical_allocation_line {
  * line_id : uuid <<PK>>
  * allocation_id : uuid <<FK, required>>
  * lot_id : uuid <<required, BC-05 ID>>
  * quantity : numeric(19,6) <<required, > 0>>
}

entity "warehouse_transfer" as warehouse_transfer {
  * transfer_id : uuid <<PK>>
  * tenant_id : uuid <<required, BC-01 ID>>
  * source_warehouse_id : uuid <<FK, required>>
  * destination_warehouse_id : uuid <<FK, required>>
  * status : varchar(32) <<required>>
  * version : integer <<required>>
}

entity "warehouse_transfer_line" as warehouse_transfer_line {
  * line_id : uuid <<PK>>
  * transfer_id : uuid <<FK, required>>
  * sku_id : uuid <<required, BC-03 ID>>
  * quantity : numeric(19,6) <<required, > 0>>
}

safety_stock_policy }o--|| warehouse : warehouse_id
inventory_position }o--|| warehouse : warehouse_id
inventory_movement }o--|| inventory_position : position_id
inventory_movement }o--o| inventory_lot : lot_id
inventory_lot }o--|| warehouse : warehouse_id
lot_disposition }o--|| inventory_lot : lot_id
inventory_reservation_line }o--|| inventory_reservation : reservation_id
warehouse_backing_line }o--|| warehouse_backing : backing_id
warehouse_backing_line }o--|| warehouse : warehouse_id
physical_allocation_line }o--|| physical_allocation : allocation_id
warehouse_transfer }o--|| warehouse : source_warehouse_id
warehouse_transfer }o--|| warehouse : destination_warehouse_id
warehouse_transfer_line }o--|| warehouse_transfer : transfer_id

note bottom of inventory_position
usable_on_hand_quantity is reconciled from immutable movement records.
active_reservation_quantity is reconciled from authoritative reservations.
Reservation is the sole demand subtraction; backing only distributes it.
end note

legend right
PK = primary key | FK = local foreign key | required = NOT NULL.
Commitment, fulfillment and SKU columns are typed references to other contexts.
Allocation, backing and reservation retain separate root identities.
endlegend
@enduml
