@startuml BC05_InventoryAvailability
title BC-05 Inventory Availability — Tactical Domain Model
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class Warehouse <<Aggregate Root>> {
  -warehouseId: WarehouseId
  -tenantId: TenantId
  -code: WarehouseCode
  -status: WarehouseStatus
  +open(): void
  +close(): void
}

class SafetyStockPolicy <<Entity>> {
  -policyId: SafetyStockPolicyId
  -skuId: SkuId
  -minimumQuantity: Quantity
  +changeMinimum(quantity: Quantity): void
}

class InventoryPosition <<Aggregate Root>> {
  -positionId: InventoryPositionId
  -warehouseId: WarehouseId
  -skuId: SkuId
  -usableOnHand: StockQuantity
  -activeReservationQuantity: StockQuantity
  -version: Version
  +applyMovement(movement: InventoryMovement): void
  +protect(quantity: Quantity): void
  +releaseProtection(quantity: Quantity): void
}

class InventoryMovement <<Entity>> {
  -movementId: InventoryMovementId
  -lotId: InventoryLotId [0..1]
  -kind: MovementKind
  -quantity: Quantity
  -occurredAt: Instant
  +record(): void
}

class InventoryLot <<Aggregate Root>> {
  -lotId: InventoryLotId
  -warehouseId: WarehouseId
  -skuId: SkuId
  -expiresAt: Instant
  -onHandQuantity: StockQuantity
  -status: LotStatus
  +receive(quantity: Quantity): void
  +hold(reason: HoldReason): void
  +releaseHold(): void
}

class LotDisposition <<Entity>> {
  -dispositionId: LotDispositionId
  -kind: DispositionKind
  -reason: String
  +record(): void
}

class InventoryReservation <<Aggregate Root>> {
  -reservationId: InventoryReservationId
  -commercialCommitmentId: CommitmentId
  -status: ReservationStatus
  +protect(): void
  +release(): void
}

class ReservationLine <<Entity>> {
  -lineId: ReservationLineId
  -skuId: SkuId
  -quantity: Quantity
}

class WarehouseBacking <<Aggregate Root>> {
  -backingId: WarehouseBackingId
  -reservationId: InventoryReservationId
  -status: BackingStatus
  +distribute(): void
  +release(): void
}

class WarehouseBackingLine <<Entity>> {
  -lineId: WarehouseBackingLineId
  -warehouseId: WarehouseId
  -skuId: SkuId
  -quantity: Quantity
}

class PhysicalAllocation <<Aggregate Root>> {
  -allocationId: PhysicalAllocationId
  -backingId: WarehouseBackingId
  -fulfillmentId: FulfillmentId
  -status: AllocationStatus
  +allocateFefo(): void
  +release(): void
}

class PhysicalAllocationLine <<Entity>> {
  -lineId: AllocationLineId
  -lotId: InventoryLotId
  -quantity: Quantity
}

class WarehouseTransfer <<Aggregate Root>> {
  -transferId: WarehouseTransferId
  -sourceWarehouseId: WarehouseId
  -destinationWarehouseId: WarehouseId
  -status: TransferStatus
  +request(): void
  +dispatch(): void
  +receive(): void
}

class WarehouseTransferLine <<Entity>> {
  -lineId: TransferLineId
  -skuId: SkuId
  -quantity: Quantity
}

class StockQuantity <<Value Object>> {
  -amount: Decimal
  +subtractChecked(other: StockQuantity): StockQuantity
}

class SellableAvailabilityPolicy <<Domain Policy>> {
  +calculate(usableOnHand: StockQuantity, activeReservations: StockQuantity, safetyStock: StockQuantity): StockQuantity
}

class FEFOAllocationPolicy <<Domain Policy>> {
  +selectEligibleLots(lots: List<InventoryLot>, quantity: Quantity): List<InventoryLot>
}

Warehouse "1" *-- "0..*" SafetyStockPolicy : policies
InventoryPosition "1" *-- "0..*" InventoryMovement : immutable movements
InventoryLot "1" *-- "0..*" LotDisposition : dispositions
InventoryReservation "1" *-- "1..*" ReservationLine : lines
WarehouseBacking "1" *-- "1..*" WarehouseBackingLine : lines
PhysicalAllocation "1" *-- "1..*" PhysicalAllocationLine : lines
WarehouseTransfer "1" *-- "1..*" WarehouseTransferLine : lines
InventoryPosition --> WarehouseId : typed root ID
InventoryPosition --> SkuId : typed BC-03 ID
InventoryMovement --> InventoryLotId : optional physical lot ID
InventoryLot --> WarehouseId : typed root ID
InventoryLot --> SkuId : typed BC-03 ID
InventoryReservation --> CommitmentId : typed BC-04 ID
WarehouseBacking --> InventoryReservationId : typed root ID
PhysicalAllocation --> WarehouseBackingId : typed root ID
PhysicalAllocation --> FulfillmentId : typed BC-06 ID
PhysicalAllocationLine --> InventoryLotId : typed root ID
WarehouseTransfer --> WarehouseId : source and destination IDs
SellableAvailabilityPolicy --> StockQuantity : calculates
FEFOAllocationPolicy --> InventoryLot : orders eligible lots
Warehouse -[hidden]down-> InventoryPosition
InventoryPosition -[hidden]down-> InventoryLot
InventoryLot -[hidden]down-> InventoryReservation
InventoryReservation -[hidden]down-> WarehouseBacking
WarehouseBacking -[hidden]down-> PhysicalAllocation
PhysicalAllocation -[hidden]down-> WarehouseTransfer

note right of InventoryPosition
Availability balance is reconciled from immutable movements.
It is not a second independently editable on-hand truth.
end note

@enduml
