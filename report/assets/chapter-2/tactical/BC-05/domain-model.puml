@startuml BC05_InventoryAvailability
title BC-05 Inventory Availability — Tactical Domain Model (TARGET)
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class Warehouse <<Aggregate Root>> {
  -warehouseId: WarehouseId
  -tenantId: TenantId
  -code: WarehouseCode
  -status: WarehouseStatus
  +open(): void
  +close(): void
  +assignZone(zone: StorageZone): void
}

class InventoryLot <<Entity>> {
  -lotId: InventoryLotId
  -warehouseId: WarehouseId
  -skuId: SkuId
  -expiresAt: Instant
  -status: LotStatus
  +receive(quantity: Quantity): void
  +hold(reason: HoldReason): void
  +releaseHold(): void
}

class InventoryPosition <<Aggregate Root>> {
  -positionId: InventoryPositionId
  -warehouseId: WarehouseId
  -skuId: SkuId
  -available: Quantity
  -version: Version
  +reserve(quantity: Quantity): void
  +release(quantity: Quantity): void
  +adjust(delta: QuantityDelta): void
  +sellableAvailability(): Quantity
}

class InventoryMovement <<Entity>> {
  -movementId: InventoryMovementId
  -lotId: InventoryLotId
  -kind: MovementKind
  -quantity: Quantity
  -occurredAt: Instant
  +record(): void
}

class SafetyStockPolicy <<Entity>> {
  -policyId: SafetyStockPolicyId
  -warehouseId: WarehouseId
  -skuId: SkuId
  -minimumQuantity: Quantity
  +changeMinimum(quantity: Quantity): void
}

class InventoryReservation <<Aggregate Root>> {
  -reservationId: InventoryReservationId
  -commercialCommitmentId: CommitmentId
  -status: ReservationStatus
  +reserve(): void
  +release(): void
}

class InventoryReservationLine <<Entity>> {
  -lineId: InventoryReservationLineId
  -reservationId: InventoryReservationId
  -skuId: SkuId
  -quantity: Quantity
  +protect(quantity: Quantity): void
}

class WarehouseBacking <<Aggregate Root>> {
  -backingId: WarehouseBackingId
  -reservationId: InventoryReservationId
  -warehouseId: WarehouseId
  -status: BackingStatus
  +distribute(): void
  +release(): void
}

class PhysicalAllocation <<Aggregate Root>> {
  -allocationId: PhysicalAllocationId
  -backingId: WarehouseBackingId
  -status: AllocationStatus
  +allocate(): void
  +release(): void
}

class PhysicalAllocationLine <<Entity>> {
  -lineId: PhysicalAllocationLineId
  -allocationId: PhysicalAllocationId
  -lotId: InventoryLotId
  -quantity: Quantity
  +consume(quantity: Quantity): void
}

class InventoryAdjustment <<Entity>> {
  -adjustmentId: InventoryAdjustmentId
  -warehouseId: WarehouseId
  -reason: AdjustmentReason
  -status: AdjustmentStatus
  +approve(): void
  +apply(): void
}

class WarehouseTransfer <<Aggregate Root>> {
  -transferId: WarehouseTransferId
  -sourceWarehouseId: WarehouseId
  -destinationWarehouseId: WarehouseId
  -status: TransferStatus
  +request(): void
  +dispatch(): void
  +receive(): void
}

class WarehouseTransferLine <<Entity>> {
  -lineId: WarehouseTransferLineId
  -transferId: WarehouseTransferId
  -skuId: SkuId
  -quantity: Quantity
  +ship(quantity: Quantity): void
  +receive(quantity: Quantity): void
}

class LotDisposition <<Entity>> {
  -dispositionId: LotDispositionId
  -lotId: InventoryLotId
  -kind: DispositionKind
  -reason: String
  +hold(): void
  +release(): void
  +destroy(): void
}

class AvailabilityPolicy <<Domain Service>> {
  +sellable(position: InventoryPosition, policy: SafetyStockPolicy): Quantity
  +selectFefo(lots: List<InventoryLot>, quantity: Quantity): List<InventoryLot>
}

interface InventoryRepository <<Repository>> {
  +findPosition(warehouseId: WarehouseId, skuId: SkuId): InventoryPosition
  +save(position: InventoryPosition): void
}

enum WarehouseStatus <<Enum>>
enum LotStatus <<Enum>>
enum ReservationStatus <<Enum>>
enum BackingStatus <<Enum>>
enum AllocationStatus <<Enum>>
enum TransferStatus <<Enum>>
enum DispositionKind <<Enum>>

Warehouse "1" o-- "0..*" InventoryLot : stores
Warehouse "1" o-- "0..*" InventoryPosition : positions
Warehouse "1" o-- "0..*" SafetyStockPolicy : policies
InventoryLot "1" *-- "0..*" InventoryMovement : movements
InventoryLot "1" *-- "0..*" LotDisposition : dispositions
InventoryReservation "1" *-- "1..*" InventoryReservationLine : protected demand
InventoryReservation "1" o-- "1..*" WarehouseBacking : warehouse distribution
PhysicalAllocation "1" *-- "1..*" PhysicalAllocationLine : physical lots
WarehouseTransfer "1" *-- "1..*" WarehouseTransferLine : lines
InventoryPosition --> Sku : stable SKU id
InventoryReservation --> CommercialCommitment : stable commitment id
InventoryReservationLine --> Sku : stable SKU id
WarehouseBacking --> Warehouse : selected warehouse id
AvailabilityPolicy ..> InventoryRepository : reads
AvailabilityPolicy --> InventoryLot : FEFO selects
InventoryPosition --> SafetyStockPolicy : protects minimum

legend right
TARGET / tactical design aid
Commercial Commitment -> Inventory Reservation -> Warehouse Backing -> Physical Allocation.
Sellable Availability = on-hand - active reservations - hold - safety stock.
FEFO is a policy over lot expiry; no cross-BC FK is implied.
*-- composition | --> domain dependency | ..> port/use
endlegend
@enduml
