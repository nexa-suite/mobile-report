@startuml
title BC-06 Fulfillment & Delivery — Logical Database Design
left to right direction
skinparam shadowing false
skinparam linetype ortho
skinparam entity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
}

entity "fulfillment" as fulfillment {
  * fulfillment_id : uuid <<PK>>
  * tenant_id : uuid <<required, BC-01 ID>>
  * sales_order_id : uuid <<required, BC-04 ID>>
  * status : varchar(32) <<required>>
  * version : integer <<required>>
}

entity "fulfillment_line" as fulfillment_line {
  * line_id : uuid <<PK>>
  * fulfillment_id : uuid <<FK, required>>
  * sku_id : uuid <<required, BC-03 ID>>
  * physical_allocation_id : uuid <<required, BC-05 ID>>
  * planned_quantity : numeric(19,6) <<required, > 0>>
  * picked_quantity : numeric(19,6) <<required, >= 0>>
}

entity "picking_result" as picking_result {
  * picking_result_id : uuid <<PK>>
  * fulfillment_id : uuid <<FK, required>>
  * status : varchar(32) <<required>>
  * actor_human_identity_id : uuid <<required, BC-01 ID>>
  * completed_at : timestamptz <<required>>
}

entity "picking_discrepancy" as picking_discrepancy {
  * discrepancy_id : uuid <<PK>>
  * picking_result_id : uuid <<FK, required>>
  * fulfillment_line_id : uuid <<FK, required>>
  * kind : varchar(32) <<required>>
  * quantity : numeric(19,6) <<required>>
}

entity "delivery" as delivery {
  * delivery_id : uuid <<PK>>
  * tenant_id : uuid <<required, BC-01 ID>>
  * fulfillment_id : uuid <<required, BC-06 ID>>
  * buyer_relationship_id : uuid <<required, BC-02 ID>>
  * status : varchar(32) <<required>>
  * destination_snapshot : jsonb <<required>>
  * version : integer <<required>>
}

entity "delivery_assignment" as delivery_assignment {
  * assignment_id : uuid <<PK>>
  * delivery_id : uuid <<FK, required>>
  * actor_human_identity_id : uuid <<required, BC-01 ID>>
    vehicle_reference : varchar(120)
  * assigned_at : timestamptz <<required>>
    unassigned_at : timestamptz
}

entity "delivery_attempt" as delivery_attempt {
  * attempt_id : uuid <<PK>>
  * delivery_id : uuid <<FK, required>>
  * attempt_number : integer <<required>>
  * attempted_at : timestamptz <<required>>
  * outcome : varchar(32) <<required>>
    unique(delivery_id, attempt_number)
}

entity "delivery_attempt_line" as delivery_attempt_line {
  * line_id : uuid <<PK>>
  * attempt_id : uuid <<FK, required>>
  * sku_id : uuid <<required, BC-03 ID>>
  * attempted_quantity : numeric(19,6) <<required, >= 0>>
}

entity "delivery_quantity_outcome" as delivery_quantity_outcome {
  * outcome_id : uuid <<PK>>
  * attempt_id : uuid <<FK, required>>
  * fulfilled_quantity : numeric(19,6) <<required, >= 0>>
  * short_quantity : numeric(19,6) <<required, >= 0>>
    reason : varchar(500)
}

entity "continuation_delivery" as continuation_delivery {
  * continuation_id : uuid <<PK>>
  * delivery_id : uuid <<FK, required>>
  * remaining_snapshot : jsonb <<required>>
  * status : varchar(32) <<required>>
}

entity "delivery_handoff_token" as delivery_handoff_token {
  * token_id : uuid <<PK>>
  * delivery_id : uuid <<FK, required>>
  * buyer_relationship_id : uuid <<required, BC-02 ID>>
  * issued_by_human_identity_id : uuid <<required, BC-01 ID>>
  * token_hash : char(64) <<required>>
  * expires_at : timestamptz <<required>>
    consumed_at : timestamptz
}

entity "buyer_receipt" as buyer_receipt {
  * receipt_id : uuid <<PK>>
  * delivery_id : uuid <<FK, required>>
  * attempt_id : uuid <<FK, required>>
  * buyer_relationship_id : uuid <<required, BC-02 ID>>
  * actor_human_identity_id : uuid <<required, BC-01 ID>>
  * accepted_quantity : numeric(19,6) <<required, >= 0>>
  * occurred_at : timestamptz <<required>>
}

entity "buyer_discrepancy" as buyer_discrepancy {
  * discrepancy_id : uuid <<PK>>
  * delivery_id : uuid <<FK, required>>
  * actor_human_identity_id : uuid <<required, BC-01 ID>>
  * reason : varchar(1000) <<required>>
  * occurred_at : timestamptz <<required>>
}

entity "proof_of_delivery" as proof_of_delivery {
  * pod_id : uuid <<PK>>
  * delivery_id : uuid <<required, BC-06 ID>>
  * captured_by_human_identity_id : uuid <<required, BC-01 ID>>
  * evidence_reference : jsonb <<required>>
  * captured_at : timestamptz <<required>>
  * sealed_at : timestamptz <<required>>
}

entity "proof_of_delivery_addendum" as proof_of_delivery_addendum {
  * addendum_id : uuid <<PK>>
  * pod_id : uuid <<FK, required>>
  * reason : varchar(500) <<required>>
  * evidence_reference : jsonb <<required>>
  * appended_at : timestamptz <<required>>
}

entity "temperature_evidence" as temperature_evidence {
  * evidence_id : uuid <<PK>>
  * delivery_id : uuid <<required, BC-06 ID>>
  * actor_human_identity_id : uuid <<required, BC-01 ID>>
  * temperature_celsius : numeric(8,3) <<required>>
  * captured_at : timestamptz <<required>>
}

entity "temperature_excursion" as temperature_excursion {
  * excursion_id : uuid <<PK>>
  * evidence_id : uuid <<FK, required>>
  * reason : varchar(500) <<required>>
  * status : varchar(32) <<required>>
}

fulfillment_line }o--|| fulfillment : fulfillment_id
picking_result }o--|| fulfillment : fulfillment_id
picking_discrepancy }o--|| picking_result : picking_result_id
picking_discrepancy }o--|| fulfillment_line : fulfillment_line_id
delivery_assignment }o--|| delivery : delivery_id
delivery_attempt }o--|| delivery : delivery_id
delivery_attempt_line }o--|| delivery_attempt : attempt_id
delivery_quantity_outcome }o--|| delivery_attempt : attempt_id
continuation_delivery }o--|| delivery : delivery_id
delivery_handoff_token }o--|| delivery : delivery_id
buyer_receipt }o--|| delivery : delivery_id
buyer_receipt }o--|| delivery_attempt : attempt_id
buyer_discrepancy }o--|| delivery : delivery_id
proof_of_delivery_addendum }o--|| proof_of_delivery : pod_id
temperature_excursion }o--|| temperature_evidence : evidence_id

note bottom of proof_of_delivery
delivery_id is an identity reference between independent roots.
No Delivery ownership relation is stored for POD or TemperatureEvidence.
end note

legend right
PK = primary key | FK = local foreign key | required = NOT NULL.
Buyer relationship and human identity are typed IDs; no buyer membership exists.
Evidence bytes are external to this logical relational design.
endlegend
@enduml
