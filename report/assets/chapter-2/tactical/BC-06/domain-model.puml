@startuml BC06_FulfillmentDelivery
title BC-06 Fulfillment & Delivery — Tactical Domain Model
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class Fulfillment <<Aggregate Root>> {
  -fulfillmentId: FulfillmentId
  -salesOrderId: SalesOrderId
  -status: FulfillmentStatus
  +start(): void
  +complete(): void
  +cancel(reason: CancellationReason): void
}

class FulfillmentLine <<Entity>> {
  -lineId: FulfillmentLineId
  -skuId: SkuId
  -physicalAllocationId: PhysicalAllocationId
  -plannedQuantity: Quantity
  +recordPicked(quantity: Quantity): void
}

class PickingResult <<Entity>> {
  -pickingResultId: PickingResultId
  -status: PickingStatus
  +confirm(): void
}

class PickingDiscrepancy <<Entity>> {
  -discrepancyId: PickingDiscrepancyId
  -kind: DiscrepancyKind
  -quantity: Quantity
  +record(): void
}

class Delivery <<Aggregate Root>> {
  -deliveryId: DeliveryId
  -fulfillmentId: FulfillmentId
  -buyerRelationshipId: BuyerRelationshipId
  -status: DeliveryStatus
  -destination: DestinationSnapshot
  +dispatch(): void
  +recordAttempt(): DeliveryAttempt
  +openContinuation(): void
}

class DeliveryAssignment <<Entity>> {
  -assignmentId: DeliveryAssignmentId
  -actorHumanIdentityId: HumanIdentityId
  -vehicleReference: String
  +assign(): void
  +unassign(): void
}

class DeliveryAttempt <<Entity>> {
  -attemptId: DeliveryAttemptId
  -attemptNumber: Integer
  -attemptedAt: Instant
  +recordOutcome(outcome: AttemptOutcome): void
}

class DeliveryAttemptLine <<Entity>> {
  -lineId: DeliveryAttemptLineId
  -skuId: SkuId
  -quantity: Quantity
}

class DeliveryQuantityOutcome <<Entity>> {
  -outcomeId: DeliveryOutcomeId
  -fulfilledQuantity: Quantity
  -shortQuantity: Quantity
  +record(): void
}

class ContinuationDelivery <<Entity>> {
  -continuationId: ContinuationDeliveryId
  -remainingSnapshot: RemainingDelivery
  +open(): void
  +close(): void
}

class DeliveryHandoffToken <<Entity>> {
  -tokenId: HandoffTokenId
  -buyerRelationshipId: BuyerRelationshipId
  -expiresAt: Instant
  +consumeOnce(): void
}

class BuyerReceipt <<Entity>> {
  -receiptId: BuyerReceiptId
  -buyerRelationshipId: BuyerRelationshipId
  -actorHumanIdentityId: HumanIdentityId
  -acceptedQuantity: Quantity
  +record(): void
}

class BuyerDiscrepancy <<Entity>> {
  -discrepancyId: BuyerDiscrepancyId
  -actorHumanIdentityId: HumanIdentityId
  -reason: String
  +record(): void
}

class ProofOfDelivery <<Aggregate Root>> {
  -podId: ProofOfDeliveryId
  -deliveryId: DeliveryId
  -capturedByHumanIdentityId: HumanIdentityId
  -capturedAt: Instant
  +seal(): void
}

class ProofOfDeliveryAddendum <<Entity>> {
  -addendumId: PodAddendumId
  -reason: String
  -evidenceReference: EvidenceReference
  +append(): void
}

class TemperatureEvidence <<Aggregate Root>> {
  -evidenceId: TemperatureEvidenceId
  -deliveryId: DeliveryId
  -capturedAt: Instant
  -temperatureCelsius: Decimal
  +record(): void
}

class TemperatureExcursion <<Entity>> {
  -excursionId: ExcursionId
  -reason: String
  +open(): void
  +close(): void
}

class DeliveryExecutionPolicy <<Domain Policy>> {
  +requiresContinuation(outcome: DeliveryQuantityOutcome): boolean
  +canSeal(pod: ProofOfDelivery): boolean
}

interface FulfillmentRepository <<Repository>> {
  +byId(id: FulfillmentId): Fulfillment
  +save(fulfillment: Fulfillment): void
}

interface DeliveryRepository <<Repository>> {
  +byId(id: DeliveryId): Delivery
  +save(delivery: Delivery): void
}

interface ProofOfDeliveryRepository <<Repository>> {
  +byId(id: ProofOfDeliveryId): ProofOfDelivery
  +save(pod: ProofOfDelivery): void
}

interface TemperatureEvidenceRepository <<Repository>> {
  +byId(id: TemperatureEvidenceId): TemperatureEvidence
  +save(evidence: TemperatureEvidence): void
}

Fulfillment "1" *-- "1..*" FulfillmentLine : lines
Fulfillment "1" *-- "0..1" PickingResult : picking result
PickingResult "1" *-- "0..*" PickingDiscrepancy : discrepancies
Delivery "1" *-- "0..*" DeliveryAssignment : assignments
Delivery "1" *-- "1..*" DeliveryAttempt : attempts
DeliveryAttempt "1" *-- "0..*" DeliveryAttemptLine : lines
DeliveryAttempt "1" *-- "0..*" DeliveryQuantityOutcome : outcomes
Delivery "1" *-- "0..*" ContinuationDelivery : continuations
Delivery "1" *-- "0..*" DeliveryHandoffToken : handoff facts
Delivery "1" *-- "0..*" BuyerReceipt : receipts
Delivery "1" *-- "0..*" BuyerDiscrepancy : discrepancies
ProofOfDelivery "1" *-- "0..*" ProofOfDeliveryAddendum : append-only addenda
TemperatureEvidence "1" *-- "0..*" TemperatureExcursion : excursions
Fulfillment --> SalesOrderId : typed BC-04 ID
FulfillmentLine --> PhysicalAllocationId : typed BC-05 ID
Delivery --> FulfillmentId : typed root ID
Delivery --> BuyerRelationshipId : typed BC-02 ID
ProofOfDelivery --> DeliveryId : typed root ID
TemperatureEvidence --> DeliveryId : typed root ID
DeliveryExecutionPolicy --> DeliveryQuantityOutcome : pure rule
DeliveryExecutionPolicy --> ProofOfDelivery : pure rule
FulfillmentRepository ..> Fulfillment : persists
DeliveryRepository ..> Delivery : persists
ProofOfDeliveryRepository ..> ProofOfDelivery : persists
TemperatureEvidenceRepository ..> TemperatureEvidence : persists
Fulfillment -[hidden]down-> Delivery
Delivery -[hidden]down-> ProofOfDelivery
ProofOfDelivery -[hidden]down-> TemperatureEvidence
FulfillmentLine -[hidden]down-> PickingResult
PickingResult -[hidden]down-> PickingDiscrepancy
DeliveryAssignment -[hidden]down-> DeliveryAttempt
DeliveryAttempt -[hidden]down-> DeliveryAttemptLine
DeliveryAttemptLine -[hidden]down-> DeliveryQuantityOutcome
DeliveryQuantityOutcome -[hidden]down-> ContinuationDelivery
ContinuationDelivery -[hidden]down-> DeliveryHandoffToken
DeliveryHandoffToken -[hidden]down-> BuyerReceipt
BuyerReceipt -[hidden]down-> BuyerDiscrepancy

note right of ProofOfDelivery
Independent immutable root.
Corrections append an addendum.
end note

@enduml
