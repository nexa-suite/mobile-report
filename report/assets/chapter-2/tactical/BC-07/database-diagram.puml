@startuml
title BC-07 Credit & Receivables — Logical Database Design
left to right direction
skinparam shadowing false
skinparam linetype ortho
skinparam entity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
}

entity "credit_account" as credit_account {
  * credit_account_id : uuid <<PK>>
  * tenant_id : uuid <<required, BC-01 ID>>
  * customer_account_id : uuid <<required, BC-02 ID>>
  * credit_limit : numeric(19,4) <<required, >= 0>>
  * currency : char(3) <<required>>
  * status : varchar(32) <<required>>
  * version : integer <<required>>
}

entity "credit_reservation" as credit_reservation {
  * reservation_id : uuid <<PK>>
  * credit_account_id : uuid <<required, BC-07 ID>>
  * commercial_commitment_id : uuid <<required, BC-04 ID>>
  * amount : numeric(19,4) <<required, > 0>>
  * currency : char(3) <<required>>
  * status : varchar(32) <<required>>
  * version : integer <<required>>
}

entity "receivable" as receivable {
  * receivable_id : uuid <<PK>>
  * tenant_id : uuid <<required, BC-01 ID>>
  * customer_account_id : uuid <<required, BC-02 ID>>
  * sales_order_id : uuid <<required, BC-04 ID>>
    business_document_id : uuid <<optional, BC-09 ID>>
  * original_amount : numeric(19,4) <<required, > 0>>
  * outstanding_amount : numeric(19,4) <<required, >= 0>>
  * currency : char(3) <<required>>
  * due_at : timestamptz <<required>>
  * status : varchar(32) <<required>>
  * version : integer <<required>>
}

entity "receivable_application" as receivable_application {
  * application_id : uuid <<PK>>
  * receivable_id : uuid <<FK, required>>
  * payment_id : uuid <<required, BC-08 ID>>
  * amount : numeric(19,4) <<required, > 0>>
  * currency : char(3) <<required>>
  * applied_at : timestamptz <<required>>
    reversed_at : timestamptz
}

entity "financial_ledger_entry" as financial_ledger_entry {
  * entry_id : uuid <<PK>>
  * receivable_id : uuid <<FK, required>>
    application_id : uuid <<FK, optional>>
  * direction : varchar(16) <<required>>
  * amount : numeric(19,4) <<required, > 0>>
  * currency : char(3) <<required>>
  * posted_at : timestamptz <<required>>
}

entity "financial_adjustment" as financial_adjustment {
  * adjustment_id : uuid <<PK>>
  * receivable_id : uuid <<required, BC-07 ID>>
  * kind : varchar(32) <<required>>
  * amount : numeric(19,4) <<required, > 0>>
  * currency : char(3) <<required>>
  * reason : varchar(500) <<required>>
  * status : varchar(32) <<required>>
  * actor_human_identity_id : uuid <<required, BC-01 ID>>
  * posted_at : timestamptz <<required>>
}

receivable_application }o--|| receivable : receivable_id
financial_ledger_entry }o--|| receivable : receivable_id
financial_ledger_entry }o--o| receivable_application : application_id

note bottom of credit_reservation
CreditReservation is a separate root referenced by identity.
It is not a child composition of CreditAccount.
CHECK: outstanding_amount is never negative or above original_amount after valid applications.
end note

legend right
PK = primary key | FK = local foreign key | required = NOT NULL.
Payment, sales order, document and customer columns are typed external IDs.
FinancialAdjustment remains independent from Receivable ownership.
endlegend
@enduml
