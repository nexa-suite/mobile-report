@startuml BC07_CreditReceivables
title BC-07 Credit & Receivables — Tactical Domain Model
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class CreditAccount <<Aggregate Root>> {
  -creditAccountId: CreditAccountId
  -customerAccountId: CustomerAccountId
  -creditLimit: Money
  -status: CreditStatus
  +approveLimit(limit: Money): void
  +suspend(reason: SuspensionReason): void
}

class CreditReservation <<Aggregate Root>> {
  -reservationId: CreditReservationId
  -creditAccountId: CreditAccountId
  -commercialCommitmentId: CommitmentId
  -amount: Money
  -status: ReservationStatus
  +reserve(): void
  +release(): void
  +consume(): void
}

class Receivable <<Aggregate Root>> {
  -receivableId: ReceivableId
  -customerAccountId: CustomerAccountId
  -salesOrderId: SalesOrderId
  -originalAmount: Money
  -outstandingAmount: Money
  -status: ReceivableStatus
  +issue(): void
  +apply(application: ReceivableApplication): void
  +close(): void
}

class ReceivableApplication <<Entity>> {
  -applicationId: ReceivableApplicationId
  -paymentId: PaymentId
  -amount: Money
  +apply(): void
  +reverse(): void
}

class FinancialLedgerEntry <<Entity>> {
  -entryId: LedgerEntryId
  -direction: LedgerDirection
  -amount: Money
  -postedAt: Instant
}

class FinancialAdjustment <<Aggregate Root>> {
  -adjustmentId: FinancialAdjustmentId
  -receivableId: ReceivableId
  -kind: AdjustmentKind
  -amount: Money
  -reason: AdjustmentReason
  +approve(): void
  +post(): void
}

class Money <<Value Object>> {
  -amount: Decimal
  -currency: CurrencyCode
}

class CreditExposurePolicy <<Domain Policy>> {
  +available(limit: Money, activeReservations: Money, outstandingReceivables: Money): Money
}

class ReceivableApplicationPolicy <<Domain Policy>> {
  +canApply(balance: Money, application: Money): boolean
  +canReverse(application: ReceivableApplication): boolean
}

CreditAccount --> CustomerAccountId : typed BC-02 ID
CreditReservation --> CreditAccountId : typed root ID
CreditReservation --> CommitmentId : typed BC-04 ID
Receivable --> CustomerAccountId : typed BC-02 ID
Receivable --> SalesOrderId : typed BC-04 ID
Receivable "1" *-- "0..*" ReceivableApplication : applications
Receivable "1" *-- "0..*" FinancialLedgerEntry : ledger entries
FinancialAdjustment --> ReceivableId : typed root ID
ReceivableApplication --> PaymentId : typed BC-08 ID
CreditExposurePolicy --> Money : pure calculation
ReceivableApplicationPolicy --> ReceivableApplication : pure rule
CreditAccount -[hidden]down-> CreditReservation
CreditReservation -[hidden]down-> Receivable
Receivable -[hidden]down-> FinancialAdjustment

note right of CreditExposurePolicy
Available credit = limit - active reservations - outstanding receivables.
end note

note right of FinancialAdjustment
Independent root. Corrections add evidence; they do not rewrite receivables.
end note
@enduml
