@startuml
title BC-08 Payments — Logical Database Design
left to right direction
hide methods
skinparam shadowing false
skinparam linetype ortho
skinparam entity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
}

entity "payment" as payment {
  * payment_id : uuid <<PK>>
  * tenant_id : uuid <<required, BC-01 ID>>
  * customer_account_id : uuid <<required, BC-02 ID>>
    commercial_commitment_id : uuid <<optional, BC-04 ID>>
  * amount : numeric(19,4) <<required>>
  * currency : char(3) <<required>>
  * method_reference : varchar(200) <<required>>
  * status : varchar(32) <<required>>
  * version : integer <<required>>
}

entity "payment_attempt" as payment_attempt {
  * attempt_id : uuid <<PK>>
  * payment_id : uuid <<FK, required>>
  * provider_code : varchar(80) <<required>>
    provider_reference : varchar(200)
  * status : varchar(32) <<required>>
  * attempted_at : timestamptz <<required>>
    completed_at : timestamptz
}

entity "payment_provider_event" as payment_provider_event {
  * event_id : uuid <<PK>>
  * payment_id : uuid <<FK, required>>
  * provider_code : varchar(80) <<required>>
  * provider_event_id : varchar(240) <<required>>
  * event_type : varchar(120) <<required>>
  * payload_digest : varchar(128) <<required>>
  * received_at : timestamptz <<required>>
    unique(provider_code, provider_event_id)
}

entity "payment_refund" as payment_refund {
  * refund_id : uuid <<PK>>
  * payment_id : uuid <<FK, required>>
  * amount : numeric(19,4) <<required>>
  * currency : char(3) <<required>>
  * reason : varchar(500) <<required>>
  * recorded_at : timestamptz <<required>>
}

entity "payment_correction" as payment_correction {
  * correction_id : uuid <<PK>>
  * payment_id : uuid <<FK, required>>
  * amount_delta : numeric(19,4) <<required>>
  * reason : varchar(500) <<required>>
  * actor_human_identity_id : uuid <<required, BC-01 ID>>
  * recorded_at : timestamptz <<required>>
}

entity "payment_reconciliation_case" as payment_reconciliation_case {
  * case_id : uuid <<PK>>
  * payment_id : uuid <<required, BC-08 ID>>
  * reason : varchar(500) <<required>>
  * status : varchar(32) <<required>>
  * opened_at : timestamptz <<required>>
    resolved_at : timestamptz
}

payment_attempt }o--|| payment : payment_id
payment_provider_event }o--|| payment : payment_id
payment_refund }o--|| payment : payment_id
payment_correction }o--|| payment : payment_id

note bottom of payment_reconciliation_case
PaymentReconciliationCase is a separate root linked by payment identity.
Provider I/O and callback processing remain outside this logical design.
end note

legend right
PK = primary key | FK = local foreign key | required = NOT NULL.
Provider events store a digest and immutable metadata, never PAN, CVV or secrets.
The unique provider/event pair supports at-least-once webhook delivery.
endlegend
@enduml
