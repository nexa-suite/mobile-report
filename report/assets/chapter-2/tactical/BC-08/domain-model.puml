@startuml BC08_Payments
title BC-08 Payments — Tactical Domain Model
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class Payment <<Aggregate Root>> {
  -paymentId: PaymentId
  -customerAccountId: CustomerAccountId
  -commercialCommitmentId: CommitmentId [0..1]
  -amount: Money
  -status: PaymentStatus
  +report(): void
  +confirm(): void
  +fail(reason: FailureReason): void
}

class PaymentAttempt <<Entity>> {
  -attemptId: PaymentAttemptId
  -providerReference: ProviderReference
  -status: AttemptStatus
  +recordResult(result: ProviderResult): void
}

class PaymentProviderEvent <<Entity>> {
  -eventId: ProviderEventId
  -provider: ProviderCode
  -providerEventId: String
  -payloadDigest: Hash
  -receivedAt: Instant
  +record(): void
}

class PaymentRefund <<Entity>> {
  -refundId: PaymentRefundId
  -amount: Money
  -reason: String
  +record(): void
}

class PaymentCorrection <<Entity>> {
  -correctionId: PaymentCorrectionId
  -amount: Money
  -reason: String
  +record(): void
}

class PaymentReconciliationCase <<Aggregate Root>> {
  -caseId: ReconciliationCaseId
  -paymentId: PaymentId
  -status: ReconciliationStatus
  +open(reason: ReconciliationReason): void
  +resolve(): void
}

class PaymentStatePolicy <<Domain Policy>> {
  +canConfirm(payment: Payment, result: ProviderResult): boolean
  +canRefund(payment: Payment, amount: Money): boolean
}

class PaymentReconciliationPolicy <<Domain Policy>> {
  +requiresCase(localStatus: PaymentStatus, providerResult: ProviderResult): boolean
}

Payment "1" *-- "1..*" PaymentAttempt : attempts
Payment "1" *-- "0..*" PaymentProviderEvent : provider facts
Payment "1" *-- "0..*" PaymentRefund : refunds
Payment "1" *-- "0..*" PaymentCorrection : corrections
Payment --> CustomerAccountId : typed BC-02 ID
Payment --> CommitmentId : optional BC-04 ID
PaymentReconciliationCase --> PaymentId : typed root ID
Payment -[hidden]down-> PaymentReconciliationCase
PaymentAttempt -[hidden]down-> PaymentProviderEvent
PaymentProviderEvent -[hidden]down-> PaymentRefund
PaymentRefund -[hidden]down-> PaymentCorrection
PaymentCorrection -[hidden]down-> PaymentReconciliationCase

note right of PaymentProviderEvent
Immutable provider fact.
Application verifies signature and deduplicates provider plus event ID.
end note

note right of PaymentReconciliationCase
Independent root for a provider/local mismatch.
end note
@enduml
