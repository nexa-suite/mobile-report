@startuml
title BC-09 Business Documents — Logical Database Design
left to right direction
hide methods
skinparam shadowing false
skinparam linetype ortho
skinparam entity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
}

entity "document_number_series" as document_number_series {
  * series_id : uuid <<PK>>
  * tenant_id : uuid <<required, BC-01 ID>>
  * document_type : varchar(32) <<required>>
  * series_code : varchar(32) <<required>>
  * next_number : bigint <<required>>
  * version : integer <<required>>
}

entity "business_document" as business_document {
  * document_id : uuid <<PK>>
  * tenant_id : uuid <<required, BC-01 ID>>
  * series_id : uuid <<required, BC-09 ID>>
  * document_type : varchar(32) <<required>>
  * document_number : varchar(80) <<required>>
    sales_order_id : uuid <<optional, BC-04 ID>>
    payment_id : uuid <<optional, BC-08 ID>>
    receivable_id : uuid <<optional, BC-07 ID>>
  * status : varchar(32) <<required>>
  * issued_at : timestamptz <<required>>
}

entity "document_snapshot_line" as document_snapshot_line {
  * line_id : uuid <<PK>>
  * document_id : uuid <<FK, required>>
  * sku_id : uuid <<required, BC-03 ID>>
  * description : varchar(500) <<required>>
  * quantity : numeric(19,6) <<required>>
  * unit_price : numeric(19,4) <<required>>
  * currency : char(3) <<required>>
}

entity "document_revision" as document_revision {
  * revision_id : uuid <<PK>>
  * document_id : uuid <<FK, required>>
  * revision_number : integer <<required>>
  * snapshot_hash : varchar(128) <<required>>
  * created_at : timestamptz <<required>>
}

entity "object_storage_reference" as object_storage_reference {
  * reference_id : uuid <<PK>>
  * document_id : uuid <<FK, required>>
  * object_key : varchar(500) <<required>>
  * content_type : varchar(160) <<required>>
  * content_length : bigint <<required>>
  * content_hash : varchar(128) <<required>>
}

entity "document_generation_request\n<<application work item>>" as document_generation_request {
  * generation_request_id : uuid <<PK>>
  * document_id : uuid <<FK, required>>
  * idempotency_key : varchar(160) <<required, unique>>
  * status : varchar(32) <<required>>
  * requested_at : timestamptz <<required>>
    completed_at : timestamptz
}

document_snapshot_line }o--|| business_document : document_id
document_revision }o--|| business_document : document_id
object_storage_reference }o--|| business_document : document_id
document_generation_request }o--|| business_document : document_id

note bottom of document_generation_request
This table is durable application work, not an Aggregate Root.
Object Storage bytes remain outside PostgreSQL.
end note

legend right
PK = primary key | FK = local foreign key | required = NOT NULL.
Source sales, payment and receivable IDs are typed cross-context references.
Object storage rows retain metadata only.
endlegend
@enduml
