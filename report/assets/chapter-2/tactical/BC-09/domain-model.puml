@startuml BC09_BusinessDocuments
title BC-09 Business Documents — Tactical Domain Model
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class BusinessDocument <<Aggregate Root>> {
  -documentId: BusinessDocumentId
  -seriesId: DocumentNumberSeriesId
  -documentType: DocumentType
  -status: DocumentStatus
  -sourceReference: SourceDocumentReference
  +issue(): void
  +supersede(): void
}

class DocumentSnapshotLine <<Entity>> {
  -lineId: DocumentSnapshotLineId
  -skuCode: String
  -description: String
  -quantity: Decimal
  -unitPrice: Money
}

class DocumentRevision <<Entity>> {
  -revisionId: DocumentRevisionId
  -revisionNumber: Integer
  -snapshotHash: ContentHash
  +seal(): void
}

class ObjectStorageReference <<Entity>> {
  -referenceId: ObjectStorageReferenceId
  -objectKey: String
  -contentType: String
  -contentHash: ContentHash
  +attachMetadata(): void
}

class DocumentNumberSeries <<Aggregate Root>> {
  -seriesId: DocumentNumberSeriesId
  -tenantId: TenantId
  -documentType: DocumentType
  -nextNumber: Long
  +reserveNumber(): DocumentNumber
}

class DocumentIssuePolicy <<Domain Policy>> {
  +canIssue(snapshot: DocumentRevision, series: DocumentNumberSeries): boolean
}

class DocumentNumberingPolicy <<Domain Policy>> {
  +isValid(number: DocumentNumber, series: DocumentNumberSeries): boolean
}

interface BusinessDocumentRepository <<Repository>> {
  +byId(id: BusinessDocumentId): BusinessDocument
  +save(document: BusinessDocument): void
}

interface DocumentNumberSeriesRepository <<Repository>> {
  +byId(id: DocumentNumberSeriesId): DocumentNumberSeries
  +save(series: DocumentNumberSeries): void
}

BusinessDocument "1" *-- "1..*" DocumentSnapshotLine : snapshot lines
BusinessDocument "1" *-- "1..*" DocumentRevision : revisions
BusinessDocument "1" *-- "0..*" ObjectStorageReference : private metadata
BusinessDocument --> DocumentNumberSeriesId : typed root ID
BusinessDocument --> SourceDocumentReference : typed source reference
DocumentIssuePolicy --> DocumentRevision : pure rule
DocumentIssuePolicy --> DocumentNumberSeries : pure rule
DocumentNumberingPolicy --> DocumentNumberSeries : pure rule
BusinessDocumentRepository ..> BusinessDocument : persists
DocumentNumberSeriesRepository ..> DocumentNumberSeries : persists
BusinessDocument -[hidden]down-> DocumentNumberSeries

note right of ObjectStorageReference
Metadata belongs to BusinessDocument.
Bytes are accessed through an application port and infrastructure adapter.
end note

note right of BusinessDocument
Issued snapshots are immutable.
Replacement creates a linked revision, not an in-place edit.
end note
@enduml
