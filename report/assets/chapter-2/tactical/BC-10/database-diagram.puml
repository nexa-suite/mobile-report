@startuml
title BC-10 Notifications — Logical Database Design
left to right direction
skinparam shadowing false
skinparam linetype ortho
skinparam entity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
}

entity "notification_template" as notification_template {
  * template_id : uuid <<PK>>
  * tenant_id : uuid <<required, BC-01 ID>>
  * template_key : varchar(160) <<required>>
  * channel : varchar(32) <<required>>
  * version : integer <<required>>
  * content_snapshot : jsonb <<required>>
  * status : varchar(32) <<required>>
    unique(tenant_id, template_key, channel, version)
}

entity "notification" as notification {
  * notification_id : uuid <<PK>>
  * tenant_id : uuid <<required, BC-01 ID>>
  * template_id : uuid <<required, BC-10 ID>>
  * source_event_id : uuid <<required>>
  * source_context : varchar(80) <<required>>
  * source_event_type : varchar(160) <<required>>
  * status : varchar(32) <<required>>
  * version : integer <<required>>
    unique(tenant_id, source_context, source_event_id, template_id)
}

entity "notification_recipient" as notification_recipient {
  * recipient_id : uuid <<PK>>
  * notification_id : uuid <<FK, required>>
  * recipient_reference : varchar(240) <<required>>
  * channel : varchar(32) <<required>>
  * destination_snapshot : varchar(320) <<required>>
  * status : varchar(32) <<required>>
}

entity "notification_attempt" as notification_attempt {
  * attempt_id : uuid <<PK>>
  * notification_id : uuid <<FK, required>>
  * recipient_id : uuid <<FK, required>>
  * channel : varchar(32) <<required>>
  * status : varchar(32) <<required>>
    provider_reference : varchar(240)
    failure_reason : varchar(500)
  * attempted_at : timestamptz <<required>>
}

entity "notification_preference" as notification_preference {
  * preference_id : uuid <<PK>>
  * tenant_id : uuid <<required, BC-01 ID>>
  * recipient_reference : varchar(240) <<required>>
  * event_type : varchar(160) <<required>>
  * channel : varchar(32) <<required>>
  * enabled : boolean <<required>>
    unique(tenant_id, recipient_reference, event_type, channel)
}

entity "push_subscription" as push_subscription {
  * subscription_id : uuid <<PK>>
  * tenant_id : uuid <<required, BC-01 ID>>
  * recipient_reference : varchar(240) <<required>>
  * installation_id : varchar(160) <<required>>
  * platform : varchar(16) <<required>>
  * provider_endpoint_reference : varchar(500) <<required, protected technical reference>>
  * provider_token_hash : char(64) <<required>>
  * status : varchar(32) <<required>>
  * version : bigint <<required>>
    unique(tenant_id, installation_id)
}

notification_recipient }o--|| notification : notification_id
notification_attempt }o--|| notification : notification_id
notification_attempt }o--|| notification_recipient : recipient_id

note bottom of push_subscription
PushSubscription is an independent root.
provider_endpoint_reference resolves through protected infrastructure storage;
provider_token_hash supports deduplication and never enables delivery alone.
end note

legend right
PK = primary key | FK = local foreign key | required = NOT NULL.
Source event columns are published-language references, not foreign keys.
Delivery attempts cannot change the source context state.
endlegend
@enduml
