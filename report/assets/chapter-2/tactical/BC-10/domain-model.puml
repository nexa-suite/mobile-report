@startuml BC10_Notifications
title BC-10 Notifications — Tactical Domain Model
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class Notification <<Aggregate Root>> {
  -notificationId: NotificationId
  -templateId: NotificationTemplateId
  -sourceFact: BusinessFactReference
  -status: NotificationStatus
  +schedule(): void
  +cancel(): void
}

class NotificationRecipient <<Entity>> {
  -recipientId: NotificationRecipientId
  -recipientReference: RecipientReference
  -channel: NotificationChannel
  +suppress(reason: SuppressionReason): void
}

class NotificationAttempt <<Entity>> {
  -attemptId: NotificationAttemptId
  -channel: NotificationChannel
  -status: AttemptStatus
  -attemptedAt: Instant
  +recordResult(): void
}

class NotificationTemplate <<Aggregate Root>> {
  -templateId: NotificationTemplateId
  -templateKey: TemplateKey
  -channel: NotificationChannel
  -version: Integer
  +publish(): void
  +retire(): void
}

class NotificationPreference <<Aggregate Root>> {
  -preferenceId: NotificationPreferenceId
  -recipientReference: RecipientReference
  -channel: NotificationChannel
  -enabled: Boolean
  +enable(): void
  +disable(): void
}

class PushSubscription <<Aggregate Root>> {
  -subscriptionId: PushSubscriptionId
  -recipientReference: RecipientReference
  -installationId: InstallationId
  -secureEndpoint: SecureEndpointReference
  -providerTokenHash: ProviderTokenHash
  -status: SubscriptionStatus
  +register(endpoint: SecureEndpointReference, hash: ProviderTokenHash): void
  +rotateEndpoint(endpoint: SecureEndpointReference, hash: ProviderTokenHash): void
  +disable(): void
}

class BusinessFactReference <<Value Object>> {
  -eventId: EventId
  -eventType: EventType
  -sourceContext: String
}

class SecureEndpointReference <<Value Object>> {
  -value: String
}

class ChannelSelectionPolicy <<Domain Policy>> {
  +choose(preference: NotificationPreference, available: List<NotificationChannel>): NotificationChannel
}

class RetryPolicy <<Domain Policy>> {
  +nextAttempt(attempt: NotificationAttempt): Instant
}

interface NotificationRepository <<Repository>> {
  +byId(id: NotificationId): Notification
  +save(notification: Notification): void
}

interface NotificationTemplateRepository <<Repository>> {
  +byId(id: NotificationTemplateId): NotificationTemplate
  +save(template: NotificationTemplate): void
}

interface NotificationPreferenceRepository <<Repository>> {
  +byId(id: NotificationPreferenceId): NotificationPreference
  +save(preference: NotificationPreference): void
}

interface PushSubscriptionRepository <<Repository>> {
  +byId(id: PushSubscriptionId): PushSubscription
  +save(subscription: PushSubscription): void
}

Notification "1" *-- "1..*" NotificationRecipient : recipients
Notification "1" *-- "0..*" NotificationAttempt : attempts
Notification --> NotificationTemplateId : typed root ID
Notification --> BusinessFactReference : source fact reference
NotificationPreference --> RecipientReference : typed recipient reference
PushSubscription --> RecipientReference : typed recipient reference
PushSubscription --> SecureEndpointReference : protected endpoint reference
ChannelSelectionPolicy --> NotificationPreference : pure rule
RetryPolicy --> NotificationAttempt : pure rule
NotificationRepository ..> Notification : persists
NotificationTemplateRepository ..> NotificationTemplate : persists
NotificationPreferenceRepository ..> NotificationPreference : persists
PushSubscriptionRepository ..> PushSubscription : persists
Notification -[hidden]down-> NotificationTemplate
NotificationTemplate -[hidden]down-> NotificationPreference
NotificationPreference -[hidden]down-> PushSubscription

note right of Notification
Delivery state never changes the source business fact.
end note

note right of PushSubscription
Independent delivery root. Provider delivery is application and infrastructure work.
end note
@enduml
