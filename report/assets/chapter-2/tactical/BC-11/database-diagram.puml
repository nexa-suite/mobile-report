@startuml
title BC-11 Target Database Diagram
left to right direction
hide methods
skinparam shadowing false
skinparam linetype ortho
skinparam entity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
}

entity "business_traceability_record" as t_business_traceability_record {
  * traceability_id : uuid <<PK>>
  * tenant_id : uuid <<required>>
    workspace_id : uuid
  * event_id : uuid <<required>>
  * event_type : varchar(160) <<required>>
  * aggregate_type : varchar(120) <<required>>
  * aggregate_id : uuid <<required>>
    actor_id : uuid
  * payload : jsonb <<required>>
  * occurred_at : timestamptz <<required>>
  * recorded_at : timestamptz <<required>>
  * payload_hash : varchar(128) <<required>>
}

entity "traceability_evidence_reference" as t_traceability_evidence_reference {
  * evidence_reference_id : uuid <<PK>>
  * traceability_id : uuid <<FK, required>>
  * evidence_kind : varchar(32) <<required>>
  * source_reference : varchar(500) <<required>>
    content_hash : varchar(128)
  * created_at : timestamptz <<required>>
}

t_traceability_evidence_reference }o--|| t_business_traceability_record : traceability_id

legend right
TARGET / BC-11 logical relational ownership / SQL is the authority
PK = primary key | FK = same-owner foreign key
required = NOT NULL | cross-BC IDs are deliberately not FK
This PlantUML file is a visual projection for review.
endlegend
@enduml
