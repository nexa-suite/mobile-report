@startuml
title BC-11 Business Traceability — Logical Database Design
left to right direction
skinparam shadowing false
skinparam linetype ortho
skinparam entity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
}

entity "business_traceability_record" as business_traceability_record {
  * traceability_id : uuid <<PK>>
  * tenant_id : uuid <<required, BC-01 ID>>
    workspace_id : uuid <<optional, BC-01 ID>>
  * source_context : varchar(80) <<required>>
  * source_event_id : uuid <<required>>
  * subject_type : varchar(120) <<required>>
  * subject_id : uuid <<required>>
    actor_human_identity_id : uuid <<optional, BC-01 ID>>
  * correlation_id : uuid <<required>>
  * occurred_at : timestamptz <<required>>
  * recorded_at : timestamptz <<required>>
  * safe_metadata : jsonb <<required>>
  * deduplication_key : varchar(240) <<required>>
    unique(tenant_id, source_context, source_event_id)
    unique(tenant_id, deduplication_key)
}

entity "traceability_evidence_reference" as traceability_evidence_reference {
  * evidence_reference_id : uuid <<PK>>
  * traceability_id : uuid <<FK, required>>
  * evidence_kind : varchar(32) <<required>>
  * external_reference_type : varchar(80) <<required>>
  * external_reference_id : varchar(500) <<required>>
    content_hash : varchar(128)
  * attached_at : timestamptz <<required>>
}

traceability_evidence_reference }o--|| business_traceability_record : traceability_id

note bottom of business_traceability_record
Rows are append-only business facts.
Application deduplicates and projects; infrastructure provides inbox, storage and transport.
end note

legend right
PK = primary key | FK = local foreign key | required = NOT NULL.
Subject, actor and external evidence IDs are typed references, not object ownership.
Safe metadata excludes secrets and payment credentials.
endlegend
@enduml
