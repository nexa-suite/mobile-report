@startuml BC11_BusinessTraceability
title BC-11 Business Traceability — Tactical Domain Model
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class BusinessTraceabilityRecord <<Aggregate Root>> {
  -traceabilityId: TraceabilityId
  -tenantId: TenantId
  -subject: BusinessObjectReference
  -actor: ActorReference
  -correlationId: CorrelationId
  -occurredAt: Instant
  +append(): void
}

class TraceabilityEvidenceReference <<Entity>> {
  -evidenceReferenceId: EvidenceReferenceId
  -kind: EvidenceKind
  -externalReference: EvidenceReference
  -contentHash: ContentHash
  +attach(): void
}

class BusinessObjectReference <<Value Object>> {
  -sourceContext: String
  -objectType: String
  -objectId: String
}

class ActorReference <<Value Object>> {
  -actorType: String
  -actorId: String
}

class CorrelationId <<Value Object>> {
  -value: String
}

class EvidenceReference <<Value Object>> {
  -referenceType: String
  -referenceId: String
}

class TraceabilityFact <<Value Object>> {
  -eventId: EventId
  -sourceContext: String
  -subject: BusinessObjectReference
}

class TraceabilityAppendPolicy <<Domain Policy>> {
  +canAppend(fact: TraceabilityFact, tenantId: TenantId): boolean
}

class SensitivePayloadPolicy <<Domain Policy>> {
  +sanitize(metadata: SafeMetadata): SafeMetadata
}

interface BusinessTraceabilityRecordRepository <<Repository>> {
  +byId(id: TraceabilityId): BusinessTraceabilityRecord
  +append(record: BusinessTraceabilityRecord): void
}

BusinessTraceabilityRecord "1" *-- "0..*" TraceabilityEvidenceReference : evidence facts
BusinessTraceabilityRecord --> BusinessObjectReference : subject
BusinessTraceabilityRecord --> ActorReference : actor
TraceabilityEvidenceReference --> EvidenceReference : typed external reference
TraceabilityAppendPolicy --> TraceabilityFact : pure rule
SensitivePayloadPolicy --> BusinessTraceabilityRecord : pure rule
BusinessTraceabilityRecordRepository ..> BusinessTraceabilityRecord : appends

note right of BusinessTraceabilityRecord
Append-only root. Correction creates another record; no edit or delete behavior exists.
end note

note right of TraceabilityEvidenceReference
Evidence is referenced, never copied or owned from another context.
end note
@enduml
